;------------------------------------------------------------------------------
; ROBINVAR.MAC -- variables and non-constant arrays: state that starts as a
; fixed initial value ported from the ZX original but is written at runtime,
; unlike ROBINDAT.MAC's data (which is read-only).
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; Room drawing variables

CURROOM:	.WORD	0	; $C548, packed room number: column in the high
				; nibble, row in the rest
TREEROOM:	.WORD	0	; $D3B6, Robin's start room -- not independently
				; rolled, just CURROOM's value right after
				; GAMEMAIN picks it (see DRAWSCENARIO)
ROOMIDX:	.WORD	0	; $C547, index into the table DESCTAB points at
DESCTAB:	.WORD	0	; $C54A, L7B39 or L8511
ROOMFLAG:	.WORD	0	; $C0E8, bit 7 of the room's world-map byte
MIRRADJ:	.WORD	0	; the column mirror adjust, 034 or 0

;------------------------------------------------------------------------------
; MIRRORBLOCK - Mirror a block horizontally, in place

MIRHDR:	.WORD	0		; the header, after its flag has been flipped

;------------------------------------------------------------------------------
; DRAWBLOCK - Draw one block token onto the shadow screen

BLKNUM:	.WORD	0		; block number from the token
BLKROW:	.WORD	0		; character row
BLKCOL:	.WORD	0		; column group, 4 character cells each
BLKHDR:	.WORD	0		; the block's header byte

;------------------------------------------------------------------------------
; Collectibles and weapons

QUIVFLAG:	.WORD	0
KEYFLAG:	.WORD	0

LIVES:		.WORD	0		; capped at 9., matching ZX's $D5A4

SWORDFLAG:	.WORD	0		; ZX $D59D
BOWFLAG:	.WORD	0		; ZX $D59E
; Magic arrows bought, 0-3 -- ZX $D5A1.  Also the trigger for a forest gate
; elsewhere ($C462's hint message, not yet ported) once it reaches 3
ARROWCOUNT:	.WORD	0
ENTPAID:	.WORD	0		; ZX $DFE6, cleared on room entry (ENTERROOM)
ENTBOWCD:	.WORD	0		; ZX $D5A0 -- currently inert, no consumer yet
ARROWHITS:	.WORD	0		; ZX $D5A5 -- currently inert, no producer yet

; Projectile array, ZX $BF67 -- 4 objects x 2 bytes, object 0 is Robin's
; arrow, objects 1-3 are the 3 guard's arrows.  Data only for now -- no
; stepper/launcher/draw/hit-test exists yet.
;
; Per object: [0] position byte, [1] direction/flags byte.  [0]=0 means the
; slot is empty.  [1] is packed and reused across the object's lifetime, not
; a clean field: bit 7 and bit 6 each select a step direction (consumed once
; per step by the flight code, then cleared); the low bits hold the row,
; which doubles as an "in-flight" animation-frame check ($0A-$0D) for the
; arrow-vs-guard hit test; after the direction bits are consumed, bit 6 gets
; reused as a mid-flight collision flag (set when the draw's XOR finds the
; pixel already on) and, for the arrow specifically, as the "hit a guard"
; flag.  Cleared 7 bytes at a time on every room change (ZX $C3BF).
PROJARR:	.BYTE	0, 0		; object 0 -- Robin's arrow
		.BYTE	0, 0		; object 1 -- guard's arrow
		.BYTE	0, 0		; object 2 -- guard's arrow
		.BYTE	0, 0		; object 3 -- guard's arrow
		.EVEN

;------------------------------------------------------------------------------
; Objects

OBJLOGN	= 30.				; live-table slots, matching $D4AD's own 30

; room, X, Y, type -- room/X/Y from $D4AD verbatim (room is the same packed
; word CURROOM/$C548 itself uses, confirmed identical encoding); type
; starts 0 (empty) and is filled in by PLACEWREATH/PLACERANDOM at GAMEMAIN
; init, never baked in here.
OBJLOG:
	.WORD	219., 80., 88., 0
	.WORD	3.,  48., 96., 0
	.WORD	4.,  92., 96., 0
	.WORD	6.,  92., 96., 0
	.WORD	14., 8.,  88., 0
	.WORD	20., 8.,  88., 0
	.WORD	33., 8.,  88., 0
	.WORD	35., 92., 96., 0
	.WORD	37., 92., 96., 0
	.WORD	46., 88., 88., 0
	.WORD	63., 80., 88., 0
	.WORD	81., 80., 88., 0
	.WORD	126.,24., 96., 0
	.WORD	128.,92., 96., 0
	.WORD	159.,40., 96., 0
	.WORD	165.,72., 96., 0
	.WORD	174.,72., 96., 0
	.WORD	177.,92., 96., 0
	.WORD	182.,92., 96., 0
	.WORD	185.,72., 96., 0
	.WORD	202.,48., 96., 0
	.WORD	218.,80., 88., 0
	.WORD	223.,92., 88., 0
	.WORD	233.,44., 96., 0
	.WORD	242.,80., 88., 0
	.WORD	245.,72., 96., 0
	.WORD	248.,24., 88., 0
	.WORD	252.,72., 96., 0
	.WORD	274.,80., 88., 0
	.WORD	286.,80., 88., 0

;------------------------------------------------------------------------------
; Guard route table, ZX $DEAB -- 3 entries of 28 bytes, indexed by $AA31's
; A = (home column - room column + 1) AND $0F: entry 0/1/2 for the guard's
; home one column left of / on / one column right of the room.  Read by
; GUARDSTEP's route scan (13$), which only tests zero/non-zero.
;
; All-zero on purpose.  In the ZX this region ships holding one-shot startup
; code (the menu/IM2 init path), which is blanked after it runs and reused as
; the route buffer; the only thing that ever refills it is a copy from $E982,
; whose contents are still unknown.  So live it reads as zero, the route scan
; never finds a step, and direction changes come only from the ~1-in-16
; facing check (15$).  The static listing's code bytes here are not route
; data -- using them made guards turn constantly.
LDEAB:	.BYTE	0,0,0,0,0,0,0,0
	.BYTE	0,0,0,0,0,0,0,0
	.BYTE	0,0,0,0,0,0,0,0
	.BYTE	0,0,0,0
LDEC7:	.BYTE	0,0,0,0,0,0,0,0
	.BYTE	0,0,0,0,0,0,0,0
	.BYTE	0,0,0,0,0,0,0,0
	.BYTE	0,0,0,0
LDEE3:	.BYTE	0,0,0,0,0,0,0,0
	.BYTE	0,0,0,0,0,0,0,0
	.BYTE	0,0,0,0,0,0,0,0
	.BYTE	0,0,0,0
	.EVEN

;------------------------------------------------------------------------------
; World map, ZX $79F9 -- one byte per room, 16. columns x 20. rows.
;
; Indexed by the packed room number: room = row * 16. + column, with the row
; wrapping at 0/19 as $C22F steps between rooms.
;
; Bits 0-6 are a descriptor index: $C072 uses it into the room-type table for
; every room, and additionally into the additional-elements table for rooms
; $00-$FF (rooms $0100 and above get the base type only).
; Bit 7 is read twice for two different purposes: $C072 stashes it, and $C2FA
; reads the same bit directly as a "special room" flag.
;
; Not constant: RECOLORCASTLE and other room-state edits write back into this
; table at runtime (ZX rooms are mutable -- e.g. a killed guard's corpse flag
; folds into room state elsewhere, and door/scenario state can be patched in
; over a room's lifetime), so it lives here rather than in ROBINDAT.MAC.
;------------------------------------------------------------------------------

L79F9:
	.BYTE	002,201,003,005,205,003,015,002,012,215,012,000,221,203,001,021	; row  0.
	.BYTE	001,017,002,014,003,013,006,004,213,011,002,215,012,203,017,022	; row  1.
	.BYTE	004,206,201,007,213,006,204,001,010,202,201,012,204,002,021,023	; row  2.
	.BYTE	013,000,015,001,207,201,042,237,041,237,042,240,041,042,005,212	; row  3.
	.BYTE	211,015,005,000,003,014,041,243,245,243,241,241,046,037,003,013	; row  4.
	.BYTE	001,210,016,001,203,005,245,037,045,377,246,043,246,045,202,005	; row  5.
	.BYTE	001,002,206,004,003,201,244,043,046,377,245,040,046,245,203,020	; row  6.
	.BYTE	015,000,002,026,003,217,041,241,043,035,043,237,043,045,202,010	; row  7.
	.BYTE	211,001,216,030,002,006,245,244,040,046,042,044,237,046,003,014	; row  8.
	.BYTE	001,213,211,013,002,003,244,037,041,045,040,042,044,246,004,212	; row  9.
	.BYTE	213,012,213,007,220,002,042,043,044,243,042,037,040,044,002,015	; row 10.
	.BYTE	224,001,010,216,005,217,231,033,232,034,231,032,031,232,026,022	; row 11.
	.BYTE	223,203,000,221,003,024,022,030,215,012,210,003,207,015,230,023	; row 12.
	.BYTE	011,001,025,206,017,023,224,017,205,000,001,014,202,005,220,212	; row 13.
	.BYTE	013,003,030,015,222,221,223,010,001,220,016,005,000,014,007,214	; row 14.
	.BYTE	022,226,202,212,022,012,021,003,014,211,023,002,003,007,015,206	; row 15.
	.BYTE	222,027,014,217,224,002,022,220,212,026,024,026,000,216,211,220	; row 16.
	.BYTE	212,000,022,006,210,003,222,007,216,030,012,027,220,212,013,024	; row 17.
	.BYTE	016,000,206,214,200,201,024,003,212,015,014,013,006,203,022,023	; row 18.
	.BYTE	205,000,004,021,215,203,206,000,016,005,221,212,015,200,012,024	; row 19.

;------------------------------------------------------------------------------
; Carried-items queue, ZX $D595 -- gold/flower only in this port (quiver
; goes to its own slot, not the queue, a deliberate deviation).  8 slots,
; one byte each, 0 = empty.  Written by the blind FIFO push in ROBINCOR.MAC.

CARRYQ:	.BLKB	8.

;------------------------------------------------------------------------------
; The per-room guard seed table -- the port of the ZX $8A39.  4 room-groups x
; 4 guard slots x 3 bytes: byte 0 = a "home" value tested against the room's
; column nibble to decide presence, byte 1 = unused until $DEAB/movement is
; ported, byte 2 bit 7 = which walk-cycle a present guard starts on.
;
; A room's group is bits 4-5 of (room number - 32.), same bucketing $C3FA
; does -- 4 buckets shared across many rooms, not one entry per room.

GSEED:	.BLKB	4*4*3

;------------------------------------------------------------------------------
; Boar object slots, one room-row-group's worth (4, matching BOARROW16-19's
; own 4 entries).  Same OBJSZ record shape as OBJTAB (ROBINCOR.MAC) -- 12.
; hardcoded rather than referencing the OBJSZ symbol, since this file is
; .INCLUDE'd before ROBINCOR.MAC and OBJSZ isn't defined yet at this point.
; Keep in sync with OBJSZ if that ever changes.

NBOAR	= 4.
	.EVEN
BOARTAB: .BLKB	NBOAR*12.

;------------------------------------------------------------------------------
; Boar seed/state data, ZX $DD3F -- 48 bytes, 4 groups of 4 x 3-byte entries.
; $DBF8 picks a group by the room's own map row: with CURROOM packed as
; row*16+column in this port (unlike ZX's split $C548/$C549 byte pair -- see
; the disasm session's own trace), rooms only have boars when CURROOM >= 256.
; (row >= 16., the bottom 4 of the world map's 20 rows), and the group index
; is simply (CURROOM>>4)-16. -- BOARROW16/17/18/19 below, one per row.
;
; Unlike guards, this is NOT a read-only template -- there's no seed/live-
; state split at all.  Per the disasm session's direct trace of $DC1F-$DC7D:
; byte 0 is the boar's home column (BPRESENT's presence test, same formula
; as guards' GPRESENT), byte 1 is the LIVE patrol cursor, stepped in place by
; the (not yet ported) roaming code and never reset on room entry or re-
; rolled -- a boar's cursor persists for the whole game, with no equivalent
; of guards' GUARDROLL reshuffle.  Byte 2 bit 6 is facing-sync, touched at
; room entry (BOARSPAWN, ROBINCOR.MAC) same as guards' own bit 6 trick; bit 7
; is the initial/current facing, picking the mirrored/normal frame list.

BOARROW16:	.BYTE	000, 100, 000
		.BYTE	005, 100, 000
		.BYTE	012, 100, 000
		.BYTE	012, 100, 200
BOARROW17:	.BYTE	000, 100, 200
		.BYTE	005, 100, 000
		.BYTE	012, 100, 000
		.BYTE	012, 100, 200
BOARROW18:	.BYTE	000, 100, 000
		.BYTE	012, 100, 000
		.BYTE	005, 100, 200
		.BYTE	012, 100, 200
BOARROW19:	.BYTE	012, 100, 000
		.BYTE	000, 100, 200
		.BYTE	005, 100, 000
		.BYTE	012, 100, 200

;------------------------------------------------------------------------------
; Tile buffer: the CPU->PPU ring.
;
; Producer is DRAWALL here, consumer is DRTILS in ROBIN1.MAC.
; Each record: 2. bytes screen address, 8. pixel bytes, 1. attribute byte, 1. pad.
; A record with a zero screen address word is free.  The screen address is
; written LAST -- that store is what publishes the record to the PPU.

	.EVEN				; the PPU reads this ring as words, at TILBUF/2
TILBUF:	.BLKB	TLBUFS*12.
TLBUFE:					; Tile buffer end
TLBUFA:	.WORD	TLBUFE-10.		; Current address in the Tile Buffer

SCRADR:	.WORD	SCRTOP			; Current screen address during a flush
CELLOFS:	.WORD	0		; Current offset into SHADOWATR / DIRTYCELLS
PIXOFS:		.WORD	0		; Current offset into SHADOWPIX

;------------------------------------------------------------------------------
; OBJPICKUP -- Robin's real pixel position, this test

RPPX:	.WORD	0			; Robin's real pixel X, this test
RPPY:	.WORD	0			; Robin's real pixel Y, this test

;------------------------------------------------------------------------------
; Pickup dispatch (PICKUPTEST/HUDCARRY and friends)

PKCOL:	.WORD	0			; this pickup's fields, captured before
PKROW:	.WORD	0			; PRINTERASE/the dispatch clobber R4
PKTYPE:	.WORD	0

HCSLOT:	.WORD	0			; HUDCARRY's own slot-index cursor

LIVEBUF:	.BYTE	060, 0, 6, 0	; one-glyph PRINTAT string: digit
					; (patched each call), terminator,
					; attribute (6 = yellow, matching the
					; ZX original), terminator

;------------------------------------------------------------------------------
; Message printer (PRINTSTR/PRINTAT and their PRTCOMMIT* sinks) -- see
; docs/MessagePrinter.md

PRTPOS:	.WORD	0			; screen address of the next cell (PRTCOMMITTIL)
PRTROW:	.WORD	0			; screen address of the current row's first cell
PRTATTP:	.WORD	0		; cursor into the attribute stream
PRTMIR:	.WORD	0			; non-zero while glyphs are mirrored
PRTLAST:	.WORD	0		; the last real attribute byte seen
PRTCOL0:	.WORD	0		; starting character column (CR returns here)
PRTCOL:		.WORD	0		; current character column (PRTCOMMITSHADOW)
PRTCROW:	.WORD	0		; current character row (PRTCOMMITSHADOW)

;------------------------------------------------------------------------------
; DRAWSPRITE/GLYPHDRAW scratch (narrow-class sprite draw, and the wide-glyph
; grid draw) -- see docs/Rendering.md

SPRSRC:		.WORD	0		; walking pointer into the frame's pixel rows
SPRROWS:	.WORD	0		; rows left to plot
SPRW:		.WORD	0		; width class, 2 or 3
SPRMIR:		.WORD	0		; mirror flag
SPRADR:		.WORD	0		; shadow address of the current row
SPRSHF:		.WORD	0		; sub-cell shift, 0 / 2 / 4 / 6 bits
SPRB0:		.WORD	0		; the row's source bytes, top to bottom
SPRB1:		.WORD	0
SPRB2:		.WORD	0
SPRDR0:		.WORD	0		; touched cell rectangle, for the dirty marks
SPRDR1:		.WORD	0
SPRDC0:		.WORD	0
SPRFLAG:	.WORD	0		; frame flag byte -- colour select + repeat bits
SPRRAMP:	.WORD	0		; -> the chosen start in the L8E1C colour ramp
SPRDCN:		.WORD	0		; footprint width, in cells, for the 80$ ramp stamp
;
GLYROWS:	.WORD	0		; wide-glyph frames: grid rows left, 5. down to 0
GLYROWSRC:	.WORD	0		; -> the current grid row's 6. glyph-code bytes
GLYROWADR:	.WORD	0		; shadow address of the current grid row, column 0
GLYPIXCNT:	.WORD	0		; font-row counter within one glyph cell, 8. down to 0

;------------------------------------------------------------------------------
; Game loop / RNG

GAMEFRAME:	.WORD	0
RNGSEED:	.WORD	1

;------------------------------------------------------------------------------
; Guard state (GUARDINIT/GUARDSTEP/GROUPADR*)

GGROUP:	.WORD	0		; this room's LIVE group base in GSEED, set by
				; GROUPADRLIVE (GUARDINIT) -- not GROUPADR's
				; respawn-target index (GUARDROLL)

GFIRESLOT: .WORD	0	; this GUARDSTEP call's guard slot (0-3, from
				; GSTEPIDX) -- stashed because R2 gets reused by
				; the route/patrol scan below before Stage 7b
				; needs it for the arrow-slot pick

GSTEPIDX:	.WORD	0		; which of the 4 guard slots is next, 0-3

; $DEAB/$DEC7/$DEE3 route-entry start address, indexed by GPRESENT's 0-2.
GROUTETAB:	.WORD	LDEAB, LDEC7, LDEE3

;------------------------------------------------------------------------------
; Boar state (BOARSPAWN/BOARSTEP)

BSTEPIDX:	.WORD	0		; which of the 4 boar slots is next, 0-3

;------------------------------------------------------------------------------
; Draw pipeline (OBJSTEP)

OBJBASE:	.WORD	0		; frame-pointer-table base, kept across DRAWFRAME

;------------------------------------------------------------------------------
; Robin state

ENERGY:		.WORD	17		; ZX default, $0F

CMTMPX:	.WORD	0		; Robin's position while the axis gates run
CMTMPY:	.WORD	0

FIREHELD:	.WORD	0		; this frame's fire bit, kept out of the
					; direction mask below -- see RSSIT

ROBST:		.BYTE	0		; 0 SIT R  1 SIT L  2 RUN R  3 RUN L  4 RUN U  5 RUN D
					; 6 STICK R  7 STICK L  8 STAGGER R  9 STAGGER L
					; (own numbering, not ZX's $0A/$0B/$0E/$0F)
	.EVEN

SWINGCNT:	.WORD	0		; stick-swing hold, ZX's $CC7A ($10 on trigger)

; Robin's animation-code register, ZX $CC7B: 0 = normal, ROBST/ROBSTATE (the
; per-frame state machine in ROBINCOR.MAC) drives him from live input as
; usual.  Nonzero = a special sequence is in progress; MOVEROBIN's own gate
; (see its top) skips the whole input/movement/state machine while this is
; set and just lets the already-armed frame-list cursor keep animating
; through OBJSTEP, same as ZX locks Robin out of normal control whenever
; $CC7B (or $CC7A) is live.  The only sequence that sets it so far is the
; critical-hit stagger, ported in ROBACTSTEP (ZX $BE25/$CB9D/$CBC7/$CBD6/
; $C055).
ROBACT:		.WORD	0

;------------------------------------------------------------------------------
