;------------------------------------------------------------------------------
; ROBINCOR.MAC -- Robin of the Wood game logic.
; Included into ROBIN1.MAC, so this is one single module; long labels allowed.
;------------------------------------------------------------------------------

; !!DEBUG!! 1 = ARROWHIT still clears a guard's arrow on contact, but skips
; ENERGY/the stagger trigger entirely -- Robin takes no damage.
DBGNODAMAG = 1

; !!DEBUG!! uncomment + set to pin GAMEMAIN's starting room
DBGINITROOM = ^X100

; !!DEBUG!! 1 = show CURROOM as 3 hex digits, bottom-right of the HUD
DBGSHOWROOM = 1

; !!DEBUG!! 1 = fill the carry FIFO with gold bags on game start
DBGGOLDMAX = 0

; !!DEBUG!! Ent's room -- stand-in for ZX's $D38E random 4-room roll, not
; yet ported.  Robin must be in this room for a purchase to fire.
DBGENTROOM = ^X026		; one of OBJLOG's own rooms, for easy testing

; !!DEBUG!! Hermit's room -- stand-in for ZX's $D392 random 3-room roll,
; not yet ported.  Decoration only; no Hermit interaction exists yet.
DBGHERMITROOM = ^X0F0		; placeholder, pick any room distinct from
				; DBGENTROOM and the OBJLOG/start rooms

; !!DEBUG!! 1 = band test still runs but OBJMATCH's actual erase/HUD-effect
; dispatch is skipped, so pickups can be walked over repeatedly while
; tuning the zone.
DBGPICKGATE = 0

; Top row number for the HUD block under the game screen and antlers
HUDROW0 = 21.


;------------------------------------------------------------------------------
; Flush all dirty cells of the play area to the screen through the TILBUF ring.
; Only the 28. inner columns are scanned: columns 0-1 and 30-31 are the fixed
; ornament frame (ZX $CDA1), which the ZX $C85C flush skips too -- so a sprite
; straying into an ornament cell corrupts only the (invisible) shadow bitmap,
; never the real screen.  Utilizes R0-R5.

DRAWALL:
	MOV	#SCRTOP, SCRADR
	CLR	CELLOFS
	CLR	PIXOFS
	MOV	#PLAYH, R1		; rows counter
DRAWALLROW:
	MOV	R1, -(SP)		; save rows counter
	ADD	#2, SCRADR		; skip the 2 left ornament columns
	ADD	#2, CELLOFS
	ADD	#2, PIXOFS
	MOV	#28., R4		; the 28. inner columns
DRAWALLCOL:
	MOV	CELLOFS, R3
	TSTB	DIRTYCELLS(R3)		; does this cell need a flush?
	BNE	DRAWCELL		; yes => emit a record
DRAWALLNEXT:
	INC	SCRADR			; screen address to the next column
	INC	CELLOFS
	INC	PIXOFS
	SOB	R4, DRAWALLCOL
; skip the 2 right ornament columns, then on to the next tile row
	ADD	#<SCRROW-PLAYW+2>, SCRADR
	ADD	#<<PLAYW*8.>-PLAYW+2>, PIXOFS	; also skips the remaining 7 pixel lines
	ADD	#2, CELLOFS
	MOV	(SP)+, R1
	SOB	R1, DRAWALLROW
	RETURN

; Emit one cell into the ring.  (The dirty flag doubles as the sprite ramp
; colour, so it is not cleared until after the attribute is taken, below.)
DRAWCELL:
; Claim the next record in the Tile Buffer
	MOV	TLBUFA, R3
	ADD	#10., R3		; to next record
	CMP	R3, #TLBUFE		; end of Tile Buffer?
	BLO	10$
	MOV	#TILBUF, R3
10$:	TST	(R3)			; is it free?
	BNE	10$			; wait for PPU to finish work
	TST	(R3)+			; skip the screen address word
	MOV	R3, TLBUFA		; update current address
; Copy 8. pixel bytes out of the shadow bitmap
	MOV	PIXOFS, R2
	ADD	#SHADOWPIX, R2
	MOV	#8., R0
20$:	MOVB	(R2), (R3)+
	ADD	#PLAYW, R2		; next pixel line
	SOB	R0, 20$
; Copy the attribute: the room's, or the sprite's ramp colour where the room
; left SHADOWATR at 0 -- the port of $C85C's $00-shadow-attr fallback.
	MOV	CELLOFS, R2
	MOVB	SHADOWATR(R2), R0
	BNE	25$
	MOVB	DIRTYCELLS(R2), R0
25$:	MOVB	R0, (R3)
	CLRB	DIRTYCELLS(R2)		; now clear the "needs a flush" flag
; Publish the record
	MOV	TLBUFA, R3
	MOV	SCRADR, -2(R3)		; write screen address - mark record to draw
;
	BR	DRAWALLNEXT

;------------------------------------------------------------------------------
; Mark a cell dirty: R0 = column, R1 = row.  Utilizes R2.

MARKDIRTY:
	MOV	R1, R2
	ASH	#5., R2			; row * 32.
	ADD	R0, R2
	MOVB	#1, DIRTYCELLS(R2)
	RETURN

; Mark the whole play area dirty -- used on room changes.  Columns 0-1 and
; 30-31 are the fixed ornament frame (drawn once, ZX $CDA1); the room flush
; leaves them alone, so they are never marked here.
MARKALLDIRTY:
	MOV	#PLAYH, R0		; rows
	MOV	#<DIRTYCELLS+2>, R1	; skip the two left ornament columns
10$:	MOV	#28., R2		; the 28. play columns
20$:	MOVB	#1, (R1)+
	SOB	R2, 20$
	ADD	#4, R1			; skip 2 right + 2 left ornament columns
	SOB	R0, 10$
	RETURN

;------------------------------------------------------------------------------
; Input state, filled by the PPU keyboard interrupt handler at PPUKEY.
; Returns the direction bitmask in R0, opposite pairs cancelled -- the port of
; the ZX $D1F1 behaviour.

READINPUT:
	MOV	@#PPUKEY, R0
	MOV	R0, R1
	BIC	#^C<PKEYRT+PKEYLT>, R1
	CMP	R1, #<PKEYRT+PKEYLT>	; both left and right?
	BNE	10$
	BIC	#<PKEYRT+PKEYLT>, R0	; yes => cancel both
10$:	MOV	R0, R1
	BIC	#^C<PKEYUP+PKEYDN>, R1
	CMP	R1, #<PKEYUP+PKEYDN>	; both up and down?
	BNE	20$
	BIC	#<PKEYUP+PKEYDN>, R0	; yes => cancel both
20$:	RETURN

;------------------------------------------------------------------------------
; Room drawing -- the port of the ZX routines at $C072 and below.
;
; A room is drawn in two passes over the same token-walking code: first the
; room type from the descriptor table at L7B39, then -- for room numbers below
; $0100 only -- the additional elements from L8511 on top.  ROOMIDX means
; different things in the two passes: the room type in the first, the room
; number itself in the second.
;
; Both tables use the same format: a count byte followed by that many 2-byte
; tokens, entries packed sequentially with no fixed stride.
;
; These routines follow the usual Z80 register mapping so they can be diffed
; against the original: R0 = A, R1 = BC, R2 = DE, R3 = HL, R4 = IX, R5 = IY.

;------------------------------------------------------------------------------
; Skip forward to the ROOMIDX-th descriptor in the table at DESCTAB -- the port
; of the ZX routine at $C1C1.
;
; Entries are variable length, so reaching entry N means walking forward over
; the N before it, each one 2*count+1 bytes long.
;
; Returns R3 -> the descriptor's count byte.
; Utilizes R1, R2.

SKIPDESC:
	MOV	DESCTAB, R3		; HL -> the first descriptor
	MOV	ROOMIDX, R1		; B = how many to skip over
	BEQ	20$			; index 0 => it is the first one
10$:	CLR	R2			; DE = 2 * token count + 1
	BISB	(R3), R2		; unsigned byte load, MOVB would sign-extend
	ASL	R2			; 2 bytes per token
	INC	R2			; plus the count byte itself
	ADD	R2, R3			; HL -> the next descriptor
	SOB	R1, 10$
20$:	RETURN

;------------------------------------------------------------------------------
; Mirror a block horizontally, in place -- the port of the ZX routine at $C1D6.
;
; Each 4-byte pixel row is reversed end for end with every byte bit-reversed
; through LFD00.  Attribute rows are swapped end for end but NOT bit-reversed,
; and are left alone entirely when the flat-attribute flag is set.
;
; The block's own header bit 7 is flipped, so the data itself records which way
; round it currently lies; DRAWBLOCK reads the header live, so a block left
; mirrored by one placement is mirrored back by the next.  The block data in
; ROBINRBL.MAC is therefore mutated in place, exactly as on the ZX.
;
; Input: R2 -> the block data, header byte first.  R2 is preserved.
; Utilizes R0-R5.

MIRRORBLOCK:
	MOV	R2, -(SP)		; keep the block address for the caller
	CLR	R0
	BISB	(R2), R0
	MOV	#200, R1
	XOR	R1, R0			; flip the block's own mirror flag
	MOVB	R0, (R2)		; the header records which way round it lies
	MOV	R0, MIRHDR
;
; pixel rows: reverse each row end for end, bit-reversing every byte
;
; The original takes the row count from bits 0-2 here, not bits 0-4 as the
; drawing code does; no block has a count above 7 so the two agree.
;
	BIC	#^C7, R0		; header AND 7 = pixel rows / 8.
	ASL	R0
	ASL	R0
	ASL	R0			; * 8. = pixel rows
	MOV	R0, R5			; row counter
	BEQ	20$
	MOV	R2, R3
	INC	R3			; -> the first pixel row
10$:	MOV	R3, R4
	ADD	#3, R4			; -> that row's right-hand end
	CALL	SWAPREVERSED		; the outer pair
	INC	R3
	DEC	R4
	CALL	SWAPREVERSED		; the inner pair
	ADD	#3, R3			; -> the next row
	SOB	R5, 10$
;
; attribute rows: swapped end for end, left as they are
;
20$:	MOV	(SP)+, R2		; the block address again
	BIT	#100, MIRHDR		; one attribute for the whole block?
	BNE	90$			; yes => nothing to swap
	MOV	MIRHDR, R0
	BIC	#^C7, R0		; attribute row count
	BEQ	90$
	MOV	R0, R5			; row counter
	MOV	MIRHDR, R0
	BIC	#^C37, R0		; pixel bytes = <header AND 037> * 32.
	ASH	#5., R0
	MOV	R2, R3
	INC	R3
	ADD	R0, R3			; -> the first attribute row
30$:	MOV	R3, R4
	ADD	#3, R4
	CALL	SWAPPLAIN		; the outer pair
	INC	R3
	DEC	R4
	CALL	SWAPPLAIN		; the inner pair
	ADD	#3, R3			; -> the next row
	SOB	R5, 30$
90$:	RETURN

; Swap the bytes at (R3) and (R4), bit-reversing both.  Utilizes R0, R1.
SWAPREVERSED:
	CLR	R0
	BISB	(R3), R0
	CLR	R1
	BISB	(R4), R1
	MOVB	LFD00(R1), (R3)
	MOVB	LFD00(R0), (R4)
	RETURN

; Swap the bytes at (R3) and (R4) as they are.  Utilizes R0.
SWAPPLAIN:
	MOVB	(R3), R0
	MOVB	(R4), (R3)
	MOVB	R0, (R4)
	RETURN

;------------------------------------------------------------------------------
; Draw one block token onto the shadow screen -- the port of the ZX routine at
; $C0D1.
;
; Blocks are always 4 character cells (32 pixels) wide.  The header byte says
; how tall:
;   bit 7      natural-mirror flag
;   bit 6      flat-attribute flag; one attribute byte fills the whole block
;   bits 0-4   pixel rows / 8., each row 4 bytes
;   bits 0-2   (reused) attribute row count, each row 4 bytes
;
; Input: BLKNUM = block number (bit 7 = the token's own mirror flag)
;        BLKROW = character row, BLKCOL = column group (0-7, 4 cells each)
; Utilizes R0-R5.

DRAWBLOCK:
; look the block up in the address table
	MOV	BLKNUM, R0
	BIC	#^C177, R0		; drop the token's mirror flag
	ASL	R0			; two bytes per entry
	MOV	L5B00(R0), R2		; DE -> the block data, header byte first
	CLR	R0
	BISB	(R2), R0		; the header byte
	MOV	R0, BLKHDR
;
; Mirror this placement?  The block's own natural-mirror flag, the token's
; mirror bit and the room's world-map bit 7 are XORed together; bit 7 of the
; result decides.  MIRRORBLOCK flips the header's flag as it goes, so a block
; already left mirrored by an earlier placement mirrors back here.
;
	MOV	BLKNUM, R1
	XOR	R1, R0			; ^ the token's own mirror bit
	MOV	ROOMFLAG, R1
	XOR	R1, R0			; ^ the room's world-map byte
	BIT	#200, R0
	BEQ	5$			; bit 7 clear => draw it as it lies
	CALL	MIRRORBLOCK		; R2 still -> the block data afterwards
	CLR	R0
	BISB	(R2), R0		; the header's flag has just flipped
	MOV	R0, BLKHDR
5$:	INC	R2			; DE -> the pixel data
;
; pixel rows: 4 bytes each, one character row apart
;
	MOV	BLKROW, R3
	SWAB	R3			; row * 256. -- one character row of pixels
	CLRB	R3			; SWAB also pulls in the old high byte; drop it
	MOV	BLKCOL, R1
	ASL	R1
	ASL	R1			; column group * 4 = character column
	MOV	MIRRADJ, R5
	XOR	R5, R1			; mirrored rooms flip the column group
	ADD	R1, R3
	ADD	#SHADOWPIX, R3		; HL -> the first pixel row
;
	MOV	BLKHDR, R0
	BIC	#^C37, R0		; header AND 037 = pixel rows / 8.
	ASL	R0
	ASL	R0
	ASL	R0			; * 8. = pixel rows
	MOV	R0, R5			; row counter
	BEQ	20$
10$:	MOV	R3, R4			; keep the row's start
	.REPT	4
	MOVB	(R2)+, (R4)+
	.ENDR
	ADD	#PLAYW, R3		; down one pixel row
	SOB	R5, 10$
;
; attribute rows: 4 bytes each, one character row apart
;
20$:	MOV	BLKROW, R3
	ASH	#5., R3			; row * 32. -- one character row of attributes
	MOV	BLKCOL, R1
	ASL	R1
	ASL	R1
	MOV	MIRRADJ, R5
	XOR	R5, R1
	ADD	R1, R3
	ADD	#SHADOWATR, R3		; HL -> the first attribute row
;
	MOV	BLKHDR, R0
	BIC	#^C7, R0		; header AND 7 = attribute row count
	BEQ	90$			; none => done
	MOV	R0, R5			; row counter
	MOV	#1, R4			; step the source one byte per cell
	BIT	#100, BLKHDR		; unless bit 6 says one attribute fills
	BEQ	30$			;   the whole block, in which case the
	CLR	R4			;   same byte is reread for every cell
30$:	MOV	R3, R1			; keep the row's start
	.REPT	4
	MOVB	(R2), (R1)+
	ADD	R4, R2
	.ENDR
	ADD	#PLAYW, R3		; down one character row
	SOB	R5, 30$
90$:	RETURN

;------------------------------------------------------------------------------
; Walk a descriptor's token list and draw each block -- the port of the ZX
; routine at $C0AF.
;
; A descriptor is a count byte followed by that many 2-byte tokens.  Each token
; is a coordinate byte plus a block number:
;   coordinate  bits 0-2  column group, 4 character cells each
;               bits 3-7  character row
;   block       index into L5B00; bit 7 is that placement's mirror flag
;
; DRAWTOKENS picks the descriptor out of DESCTAB using ROOMIDX; DRAWTOKENSAT
; takes R3 pointing straight at one, for the scenario token lists at $C15E.
;
; Utilizes R0-R5.

DRAWTOKENS:
	CALL	SKIPDESC		; R3 -> the ROOMIDX-th descriptor
DRAWTOKENSAT:
	CLR	R0
	BISB	(R3)+, R0		; the token count
	BEQ	90$			; zero => nothing to draw
;
; DRAWBLOCK clobbers every register, so the counter and the token pointer are
; both kept on the stack across it.
;
10$:	MOV	R0, -(SP)		; save the counter
	MOV	R3, -(SP)		; save the token pointer
	CLR	R0
	BISB	(R3)+, R0		; the coordinate byte
	MOV	R0, R1
	BIC	#^C7, R1
	MOV	R1, BLKCOL		; bits 0-2 = column group
	ASR	R0
	ASR	R0
	ASR	R0			; bits 3-7 = character row
	BIC	#^C37, R0
	MOV	R0, BLKROW
	CLR	R0
	BISB	(R3), R0		; the block number
	MOV	R0, BLKNUM
	CALL	DRAWBLOCK
	MOV	(SP)+, R3		; the token pointer again
	ADD	#2, R3			; -> the next token
	MOV	(SP)+, R0		; the counter again
	SOB	R0, 10$
90$:	RETURN

; Draws whichever of the Ent/Hermit/start-tree decorations belongs in
; CURROOM, if any -- port of ZX $C15E, called once per room entry.
; Utilizes R0-R5 (via DRAWTOKENSAT).
DRAWSCENARIO:
	CMP	CURROOM, #DBGENTROOM
	BNE	10$
	MOV	#SCENENT, R3
	BR	DRAWTOKENSAT
10$:	CMP	CURROOM, #DBGHERMITROOM
	BNE	20$
	MOV	#SCENHERMIT, R3
	BR	DRAWTOKENSAT
20$:	CMP	CURROOM, TREEROOM
	BNE	99$
	MOV	#SCENTREE, R3
90$:	BR	DRAWTOKENSAT
99$:	RETURN

;------------------------------------------------------------------------------
; Draw the room CURROOM onto the shadow screen -- the port of the ZX routine
; at $C072.
;
; Two passes over DRAWTOKENS: the room type from L7B39, then -- for room
; numbers below $0100 only -- that room's additional elements from L8511 drawn
; on top.  ROOMIDX carries the room type in the first pass and the room number
; itself in the second.
;
; The room's world-map byte drives both the per-block mirror decision (its bit
; 7 feeds DRAWBLOCK's XOR through ROOMFLAG) and the column flip (MIRRADJ), so
; a mirrored room has its blocks both flipped and moved to the opposite
; column group.
;
; Utilizes R0-R5.

DRAWROOM:
	MOV	#L7B39, DESCTAB		; first pass: the room type
	MOV	CURROOM, R3
	CLR	R0
	BISB	L79F9(R3), R0		; the room's world-map byte
	MOV	R0, ROOMFLAG		; kept whole; only bit 7 is read later
	CLR	MIRRADJ
	BIT	#200, R0
	BEQ	10$
	MOV	#34, MIRRADJ		; mirrored room: 034 flips the column group
10$:	BIC	#200, R0		; bits 0-6 = the room type
	MOV	R0, ROOMIDX
	CALL	DRAWTOKENS
;
	MOV	CURROOM, R0
	CMP	R0, #400		; room $0100 or above?
	BHIS	90$			; yes => the base room type only
	MOV	R0, ROOMIDX		; the second pass indexes by room number
	MOV	#L8511, DESCTAB
	BR	DRAWTOKENS
90$:	RETURN

;------------------------------------------------------------------------------
; Castle attribute recolour -- the port of the ZX routine at $C40E.
;
; The ZX runs this right after a room is drawn, for the 26. castle-area rooms
; listed at LC550 (ROBINDAT.MAC).  It rewrites every shadow attribute cell of
; the room:
;   non-black paper           -> white ink on black    (attr 007)
;   black paper, non-white ink -> cyan ink on black    (attr 005; the ZX has
;                                bright cyan 105, bright is dropped here)
;   black paper, white ink     -> left as it is
;   empty cell (000)           -> left as it is
;
; Not a rooms-$0100+ concern: those never match the table.  Utilizes R0-R3.

RECOLORCASTLE:
	MOV	CURROOM, R0
	CMP	R0, #400		; room $0100 or above never matches
	BHIS	90$
	MOV	#LC550, R1		; scan the 26. entries for this room
	MOV	#26., R2
10$:	CMPB	(R1)+, R0
	BEQ	20$
	SOB	R2, 10$
	RETURN				; not a castle room
20$:	MOV	#SHADOWATR, R1
	MOV	#<PLAYH*PLAYW>, R2	; every attribute cell of the play area
30$:	MOVB	(R1), R0
	BEQ	40$			; empty cell => leave it
	BIC	#^C70, R0		; paper bits 3-5
	BEQ	50$			; black paper => check the ink
	MOVB	#007, (R1)		; non-black paper => white on black
	BR	40$
50$:	MOVB	(R1), R0
	BIC	#^C7, R0		; ink bits 0-2
	CMP	R0, #7
	BEQ	40$			; already white ink => leave it
	MOVB	#005, (R1)		; black paper, other ink => cyan on black
40$:	INC	R1
	SOB	R2, 30$
90$:	RETURN

;------------------------------------------------------------------------------
; Clear the shadow screen -- the port of the ZX routine at $D03F.
;
; The ZX caller does XOR A first, so both areas are filled with 0.  Utilizes
; R0, R1.

CLRSHADOW:
	MOV	#SHADOWPIX, R1
	MOV	#<<<PLAYH*8.>*PLAYW>+<PLAYH*PLAYW>>/2, R0	; pixels + attrs, words
10$:	CLR	(R1)+
	SOB	R0, 10$
	RETURN

;------------------------------------------------------------------------------
; Enter the room CURROOM: build its shadow screen and queue the whole play
; area for the flush.  The core of the ZX room-entry sequence at $C024
; ($D03F / $C072 / $C15E / $C444 / $C40E / $C462 / $C276); the pieces not yet
; ported are marked below.
;
; Utilizes R0-R5.

ENTERROOM:
	CLR	ENTPAID			; ZX $DFE6 -- one Ent purchase per visit
	MOV	#PROJARR, R0		; ZX $C3BF -- clears the arrow and the 3
	CLR	(R0)+			; guard's arrows, all 4 words
	CLR	(R0)+
	CLR	(R0)+
	CLR	(R0)
	CALL	CLRSHADOW		; $D03F
	MOV	#LB587, R0		; the left and right screen ornaments ($CDA1)
	CALL	PRINTSTR
	MOV	#LB5C0, R0
	CALL	PRINTSTR
	MOV	#LD2C3, R0		; the branched antlers -- energy shown via the
	CALL	PRINTSTR		; display-list palette splice, not their attrs
	MOV	#LD305, R0
	CALL	PRINTSTR
	CALL	DRAWROOM		; $C072
	CALL	DRAWSCENARIO		; $C15E
	;TODO: $C444 -- room $BB special recolour
	CALL	RECOLORCASTLE		; $C40E
	;TODO: $C462 -- single-column-room hint message
	;TODO: $C276 -- build the room's guards / boars
	CALL	MARKALLDIRTY
	CALL	OBJSHOW			; $D5A7's icon half -- this room's pickup, if
					; any.  After MARKALLDIRTY, not before: it
					; blanket-stamps DIRTYCELLS to a flat 1 across
					; the whole play area, which would otherwise
					; stomp the real colour PRTCOMMITSHADOW just
					; wrote there back down to 1.
	JMP	DRAWALL			; flush the room first so the ornaments land on top

;------------------------------------------------------------------------------
; Room pickup icons -- the display half of the ZX $D5A7/$D543 pipeline.
; OBJLOG's 30 entries are ZX's own $D4AD authored (room,X,Y) map positions,
; transcribed verbatim (see the table below); what varies game to game is
; only each entry's *type* word, randomised at boot by PLACEWREATH/
; PLACERANDOM (ports of $D3F3/$D402) instead of being baked in here.
;
; This still collapses ZX's real indirection ($D4AD's message drives a
; room-entry text banner via $D619/$D631 whose "arrow marker" mode arms a
; trigger in $D57A, which $D7F3/OBJPICKUP then tests, only then reaching
; $D9F6's type) into one direct (room,X,Y,type) list -- no $D57A trigger-
; arming/text-banner layer is ported, same simplification this port has
; used since OBJLOG was first added.
;
; X/Y are in the exact same coordinate units as Robin's own ROBIN+6/+7
; fields -- X in 2-pixel units, Y in real pixels, not character cells --
; confirmed to need zero conversion from $D4AD's own raw posD/posE bytes.
; type 0 = empty slot (skipped by OBJSHOW/OBJPICKUP); ZX's own $D9F6
; values otherwise: 1=wreath, 2=gold, 5=flower, 6=key, 7=quiver.

; type -> icon string address (+1/+2 header-skip baked in, mirrors ZX's
; own per-type $D7D0 icon pointers for the 5 types this port handles).
TYPICON:
	.WORD	0			; 0: unused (empty slot)
	.WORD	LB536+1			; 1: wreath
	.WORD	LB512+1			; 2: gold
	.WORD	0			; 3: unused
	.WORD	0			; 4: unused
	.WORD	LB548+1			; 5: flower
	.WORD	LB52E			; 6: key (no header to skip)
	.WORD	LB57C+1			; 7: quiver

; Scan OBJLOG for CURROOM; PRINTGAME every match's icon (a room can now
; hold more than one live pickup).  Utilizes R0-R5.
OBJSHOW:
	MOV	#OBJLOG, R4
	MOV	#OBJLOGN, R3
10$:	MOV	6(R4), R0
	BEQ	20$			; type 0 -- empty slot
	CMP	(R4), CURROOM
	BNE	20$
	MOV	2(R4), R1		; X, 2-pixel units -> char column = X/4.
	ASR	R1
	ASR	R1
	MOV	4(R4), R2		; Y, real pixels -> char row = Y/8.
	ASR	R2
	ASR	R2
	ASR	R2
	ASL	R0			; type * 2 = TYPICON word offset
	MOV	TYPICON(R0), R0		; -> the icon string
	MOV	R4, -(SP)		; PRINTGAME clobbers R0-R5 -- save the scan
	MOV	R3, -(SP)		; pointer and the loop counter across it
	CALL	PRINTGAME
	MOV	(SP)+, R3
	MOV	(SP)+, R4
20$:	ADD	#10, R4			; next entry, 4 words = 10 octal bytes
	SOB	R3, 10$
	RETURN

;------------------------------------------------------------------------------
; Random pickup placement at game start -- ports of ZX's $D47D/$D3F3/$D402.
; Uses PRNG (this port's LFSR, further down this file) in place of ZX's R-
; register sampling.

; Find a free (type 0) OBJLOG slot: port of $D47D.  Random start index
; 0-29 via PRNG, clamped like $D47D's own AND $1F / CP $1E retry, then a
; linear scan forward from there, wrapping at 30 back to 0, for the first
; type-0 entry.  Returns R4 -> that entry.  Utilizes R0, R2-R4.
FINDFREESLOT:
	CALL	PRNG
	BIC	#^C37, R0		; mask to 0-31
1$:	CMP	R0, #30.
	BLT	2$
	DEC	R0			; >= 30 -- decrement and retry (matches $D47D)
	BR	1$
2$:	MOV	R0, R2			; R2 = the starting index, for wrap detection
	MOV	#OBJLOG, R4
	MOV	R0, R3
	ASL	R3
	ASL	R3
	ASL	R3			; * 8. = byte offset (4-word, 10-octal stride)
	ADD	R3, R4			; R4 -> OBJLOG[R0]
3$:	TST	6(R4)			; type word: 0 = free
	BEQ	9$
	ADD	#10, R4			; next entry, wrapping at 30 back to OBJLOG
	INC	R0
	CMP	R0, #30.
	BLT	4$
	CLR	R0
	MOV	#OBJLOG, R4
4$:	CMP	R0, R2			; wrapped all the way back? (shouldn't happen --
	BNE	3$			; 30 slots, at most 6+9+11 = 26. ever placed)
9$:	RETURN

; Force 6 guaranteed wreaths: port of $D3F3.  Slot 0 is always one (matches
; $D4B1's own forced slot-0 wreath); 5 more via FINDFREESLOT.  Utilizes
; R0, R2-R4.
PLACEWREATH:
	MOV	#1, OBJLOG+6		; slot 0's type word
	MOV	#5., R5
1$:	CALL	FINDFREESLOT
	MOV	#1, 6(R4)
	SOB	R5, 1$
	RETURN

; Random flower/quiver counts into free slots: port of $D402.  Utilizes
; R0, R2-R5.
PLACERANDOM:
	CALL	PRNG			; flowers: 6-9, matching $D40A-$D41A's
	BIC	#^C3, R0		; two-roll sum
	MOV	R0, R5
	CALL	PRNG
	BIC	#^C1, R0
	ADD	R0, R5
	ADD	#6., R5
1$:	CALL	FINDFREESLOT
	MOV	#5, 6(R4)
	SOB	R5, 1$
;
	CALL	PRNG			; quivers: 8-11, matching $D42F-$D43F
	BIC	#^C3, R0
	MOV	R0, R5
	CALL	PRNG
	BIC	#^C1, R0
	ADD	R0, R5
	ADD	#8., R5
2$:	CALL	FINDFREESLOT
	MOV	#7, 6(R4)
	SOB	R5, 2$
	RETURN

;------------------------------------------------------------------------------
; Pickup collision, called once per game frame.  Based on the ZX's own
; $D7F3 pixel-band test, tuned live against the actual UKNC screen:
;   X = max(px,4.)-4. in [xref,xref+24.); Y = py+12. in [yref,yref+24.)
; -- two independent pixel-precise ranges against the icon's own printed
; position, not a cell-snapped or sprite-hitbox test.  px = 2*field6 (Robin's
; field 6 is 2-pixel units -- X=64. spawn confirmed live as ZX's screen-
; centre $40, real pixel px=128.); py = field7 (already real pixels).
; (xref,yref) is the icon's, straight from OBJLOG's own X/Y -- stored in
; the same 2-pixel-unit/real-pixel coordinate pair as Robin's fields, not
; character cells, so xref = OBJLOG.X * 2. and yref = OBJLOG.Y with no
; further conversion.
;
; Utilizes R0-R4.

OBJPICKUP:
	MOV	#ROBIN, R4
	CLR	R0
	BISB	6(R4), R0		; Robin's X, 2-pixel units
	ASL	R0			; * 2. = real pixel X
	CMP	R0, #4.
	BGE	1$
	MOV	#4., R0
1$:	SUB	#4., R0			; X = max(px,4.) - 4.
	MOV	R0, RPPX
	CLR	R0
	BISB	7(R4), R0		; Robin's Y, already real pixels
	ADD	#12., R0		; Y = py + 12.
	MOV	R0, RPPY
;
	MOV	#OBJLOG, R4
	MOV	#OBJLOGN, R3
10$:	TST	6(R4)
	BEQ	20$			; type 0 -- empty slot
	CMP	(R4), CURROOM
	BNE	20$
; X band: xref <= RPPX < xref+16., xref = OBJLOG.X * 2. (2-pixel units -> real)
	MOV	2(R4), R1
	ASL	R1			; * 2. = xref
	CMP	RPPX, R1
	BLT	20$
	ADD	#24., R1
	CMP	RPPX, R1
	BGE	20$
; Y band: yref <= RPPY < yref+16., yref = OBJLOG.Y (already real pixels)
	MOV	4(R4), R2
	CMP	RPPY, R2
	BLT	20$
	ADD	#24., R2
	CMP	RPPY, R2
	BGE	20$
;
  .IF NE DBGPICKGATE
	BR	20$			; gated: count as a hit but leave the entry live
  .ENDC
	BR	OBJMATCH		; too far for a branch now the dispatch
					; block sits well past 20$/SOB below
20$:	ADD	#10, R4			; next entry, 4 words = 10 octal bytes
	SOB	R3, 10$
	RETURN
;
; match -- capture the entry's fields and disable it immediately (before
; PRINTERASE/the type dispatch below clobber R4), then erase the world
; icon and apply this type's own HUD effect.
OBJMATCH:
	MOV	2(R4), PKCOL
	MOV	4(R4), PKROW
	MOV	6(R4), PKTYPE
	CLR	6(R4)			; disable this entry -- OBJSHOW won't redraw
					; it, this routine won't retest it
;
	MOV	PKTYPE, R0
	ASL	R0			; type * 2 = TYPICON word offset
	MOV	TYPICON(R0), R0		; -> the icon string
	MOV	PKCOL, R1		; X, 2-pixel units -> char column = X/4.
	ASR	R1
	ASR	R1
	MOV	PKROW, R2		; Y, real pixels -> char row = Y/8.
	ASR	R2
	ASR	R2
	ASR	R2
	CALL	PRINTERASE		; XOR the world icon's pixels back off
;
	MOV	PKTYPE, R2
	CMP	R2, #2			; gold
	BNE	30$
	MOV	#2, R0
	BR	CARRYPUSH
30$:	CMP	R2, #5			; flower
	BNE	40$
	MOV	#5, R0
	BR	CARRYPUSH
40$:	CMP	R2, #7			; quiver
	BEQ	QUIVPICKUP
50$:	CMP	R2, #6			; key
	BEQ	KEYPICKUP
60$:	CMP	R2, #1			; wreath
	BEQ	WREATHPICKUP
90$:	RETURN

;------------------------------------------------------------------------------
; What picking each type up does, beyond erasing its world icon (handled
; above already).  Ported from this session's disasm study of $D94B/$DB98/
; $D91A/$D8FE (docs/Objects.md) -- see the plan for exactly which parts are
; faithful ports vs. this port's own additions (quiver/key's dedicated HUD
; slots: ZX's own $D8FE routes quiver into the carry queue and key into an
; unrelated pre-existing flag, neither with a persistent icon; the wreath
; life-counter path is a faithful port of $D91A).

; Blind FIFO push, matching $D94B: shift CARRYQ[0..6] -> [1..7], the
; incoming value (R0, 2=gold or 5=flower) into the freed front slot.  No
; cap check -- the oldest carried item silently falls off, same as ZX.
; Utilizes R0, R1, R3, R4.
CARRYPUSH:
	MOV	R0, -(SP)		; save the incoming value across the shift
	MOV	#<CARRYQ+7.>, R4	; walk from the back
	MOV	#7., R3
10$:	MOVB	-1(R4), (R4)
	DEC	R4
	SOB	R3, 10$
	MOV	(SP)+, R0
	MOVB	R0, CARRYQ
	;BR	HUDCARRY		; falls straight through

; Redraw all 8 carry slots at fixed HUD positions -- covers both $D94B's
; "just pushed one" and $DB98's "full refresh" call sites with one shared
; routine.  Empty (0) slots draw CARRYBLANK, not skip -- a slot emptied by
; CARRYPOP/the FIFO shift must erase its old icon, not just leave it.  Own
; HUD coordinates, not a port of $D9F9's exact pixel packing.  Utilizes
; R0-R5.
HUDCARRY:
	MOV	#CARRYQ, R4
	CLR	HCSLOT
10$:	CLR	R0
	BISB	(R4)+, R0		; this slot's value
	CMP	R0, #2
	BNE	20$
	MOV	#LB512+1, R0		; gold icon
	BR	40$
20$:	CMP	R0, #5
	BNE	30$
	MOV	#LB548+1, R0		; flower icon
	BR	40$
30$:	MOV	#CARRYBLANK, R0		; empty slot -- erase, don't skip
40$:	MOV	HCSLOT, R1		; ZX $D9F9's own 4x2 grid (decoded from its
	BIC	#^C3, R1		; raw position bytes): column 12./14./16./18.
	ASL	R1			; for slot mod 4, row HUDROW0 for slot < 4,
	ADD	#12., R1		; HUDROW0+2. for slot >= 4
	MOV	#HUDROW0, R2
	CMP	HCSLOT, #4.
	BLT	45$
	MOV	#<HUDROW0+2.>, R2
45$:	MOV	R4, -(SP)		; PRINTAT clobbers R4 -- save the queue
	CALL	PRINTAT			; pointer across the call
	MOV	(SP)+, R4
50$:	INC	HCSLOT
	CMP	HCSLOT, #8.
	BLT	10$
	RETURN

; Quiver -- this port's own dedicated always-shown HUD slot (see header
; note above; ZX's own $D8FE would route this into the carry queue
; instead).  Drawn once, on pickup.  Utilizes R0-R5.
QUIVPICKUP:
	MOV	#1, QUIVFLAG
	MOV	#LB567+2, R0		; upright/HUD quiver variant, its own 2-byte
	MOV	#5., R1			; position header ($14,$A8) decodes to
	MOV	#<HUDROW0+2.>, R2	; column 5. -- row bumped one lower
	JMP	PRINTAT

; Key -- this port's own dedicated always-shown HUD slot (see header note
; above; ZX's own $D8FE only flips the unrelated $D59F re-seed flag here,
; no icon).  Drawn once, on pickup.  Utilizes R0-R5.
KEYPICKUP:
	MOV	#1, KEYFLAG
	MOV	#LB52E+1, R0		; ZX $B52D/$B52E's own 2-byte position header
	MOV	#8., R1			; ($20,$A0 -- LB52D's single byte plus
	MOV	#HUDROW0, R2		; LB52E's first) decodes to column 8., row 20.
	JMP	PRINTAT

; Wreath -- faithful port of $D91A: capped (max 9.) life counter, archer
; icon drawn once per pickup, count redrawn as a single ASCII digit next
; to it.  $D91A's own second *text* message ($DA09) is not ported --
; out of scope, the icon+count is the core signal.  Utilizes R0-R5.
WREATHPICKUP:
	CMP	LIVES, #9.
	BGE	DRAWLIVES
	INC	LIVES
;
; Redraw the icon+count from the current LIVES -- also called directly
; (ROBACTSTEP) after the critical-hit stagger's own -2 penalty, which
; doesn't go through the pickup path above.
DRAWLIVES:
	MOV	#LB51F+2, R0		; archer icon, its own 2-byte position header
	MOV	#7., R1			; skipped.  ZX $B51F's own position bytes
	MOV	#<HUDROW0+2.>, R2	; ($1C,$B0) decode to column 7., row 22.
	CALL	PRINTAT
;
	MOV	LIVES, R0
	BGE	1$			; clamp the DISPLAYED digit at 0 -- LIVES
	CLR	R0			; itself stays negative (the stagger's -2
1$:	CALL	HEXDIG			; penalty going through 0) for GAMEOVER's own
					; check; R0 := ASCII digit (fits one nibble)
	MOVB	R0, LIVEBUF
	MOV	#LIVEBUF, R0		; ZX $DA09's own position bytes ($24,$B8)
	MOV	#9., R1			; decode to column 9., row 23. -- one row
	MOV	#<HUDROW0+3.>, R2	; below the archer, not aligned with it
	BR	PRINTAT

;------------------------------------------------------------------------------
; The Ent, weapon seller -- port of ZX's $DF03.  Bring 3 gold slots to his
; room (DBGENTROOM, above) and each visit buys the next unowned item:
; sword, then bow, then one of 3 magic arrows.  Not ported: the ~8M-
; iteration eye-blink busy-wait ($DFCA -- doesn't fit this port's non-
; blocking per-frame loop) and the 3 magic arrows' distinct purchase text
; (never transcribed into this port's data files, only the one LB556
; icon exists) -- matches this port's established "icon+count is the
; core signal" simplification, same as the wreath counter's own skipped
; second message.

; Remove up to 3 gold (2) slots from CARRYQ, shifting the rest down and
; zero-filling the vacated tail, then redraw the carry row.  Port of
; $DB82's effect, adapted to CARRYQ's own 0=empty blind-array model
; rather than $D595's raw semantics.  Utilizes R0-R4.
CARRYPOP:
	MOV	#CARRYQ, R3		; read cursor
	MOV	#CARRYQ, R4		; write cursor
	CLR	R2			; slots dropped so far
	MOV	#8., R1
10$:	CLR	R0
	BISB	(R3)+, R0
	CMP	R0, #2
	BNE	20$
	CMP	R2, #3.
	BGE	20$
	INC	R2			; drop this one -- still need more removed
	BR	30$
20$:	MOVB	R0, (R4)+		; keep this slot
30$:	SOB	R1, 10$
;
	MOV	#<CARRYQ+8.>, R1	; zero-fill from the write cursor to the end
40$:	CMP	R4, R1
	BGE	HUDCARRY
	CLRB	(R4)+
	BR	40$

; Called once per frame from GAMELOOP.  Utilizes R0-R4.
ENTCHECK:
	CMP	CURROOM, #DBGENTROOM	; only in the Ent's room
	BNE	90$
	CMP	ARROWCOUNT, #3.		; gates the whole routine once all 3 magic
					; arrows are bought (matches ZX $DF0E -- this
					; check runs before sword/bow too, not just
					; the arrow branch)
	BEQ	90$
	TST	ENTPAID			; one purchase per visit
	BNE	90$
	CALL	PRNG			; ~1-in-256 throttle, matching ZX's R-roll
	CMP	R0, #1
	BNE	90$
;
	MOV	#CARRYQ, R4		; count gold (2) slots; need >= 3
	MOV	#8., R3
	CLR	R2
10$:	CLR	R0
	BISB	(R4)+, R0
	CMP	R0, #2
	BNE	20$
	INC	R2
20$:	SOB	R3, 10$
	CMP	R2, #3.
	BLT	90$
;
	CALL	CARRYPOP		; remove 3 gold, redraw the carry row
	MOV	#1, ENTPAID
;
	TST	SWORDFLAG
	BNE	30$
	MOV	#1, SWORDFLAG
	MOV	#LB495, R0		; sword icon/message, own position header
	BR	PRINTSTR
30$:	TST	BOWFLAG
	BNE	40$
	MOV	#1, BOWFLAG
	ADD	#10., ENTBOWCD		; inert for now, faithful to $DF74
	MOV	#LB567, R0		; quiver-bought confirmation icon
	CALL	PRINTSTR
	MOV	#LB4C1, R0		; bow icon/message
	BR	PRINTSTR
40$:	MOV	#LB556+1, R0		; magic-arrow icon.  Leading pad byte skipped
					; like gold/flower/quiver-laying -- LB556 has
					; no embedded header the way sword/bow do, so
					; this needs PRINTAT's explicit column/row,
					; not PRINTSTR.  1 glyph wide x 4 rows tall
					; (its own 3 CRs).  Each of the 3 arrows gets
					; its own column (ARROWCOUNT is 0-based here,
					; before the INC below) so all 3 stay visible
					; at once, 1 empty column apart -- not one
					; spot redrawn each purchase.
	MOV	ARROWCOUNT, R1
	ADD	#2., R1			; base column -- left HUD edge
	MOV	#HUDROW0, R2		; rows 21-24
	CALL	PRINTAT
	INC	ARROWCOUNT
	;TODO: ARROWCOUNT==3 -- open the forest gate ($C462's hint message,
	; not yet ported)
90$:	RETURN

;------------------------------------------------------------------------------
; Print a message string straight into the TILBUF ring -- the port of the ZX
; message printer at $D619 / $D661 / $D68B.
;
; One glyph is one 8x8 cell is one ring record; each record is published the
; moment it is filled, so the PPU draws the text exactly like room cells.
; Nothing touches the shadow screen.
;
; String layout: a 2-byte position header, then a glyph / control stream ending
; in 000, then one attribute byte per glyph and a trailing 000.  Control 001 =
; carriage return plus down one row, 002 / 003 = mirror the following glyphs on
; / off.  In the attribute stream 377 is the matching row separator.
;
; The two streams are walked in lockstep: one attribute byte is consumed per
; glyph, and the attribute cursor steps past its 377 whenever the glyph stream
; hits a 001.  If the attribute stream runs out (an empty one, like the
; ornaments have), cells fall back to PRTATTR.
;
; Position header: byte 0 = column, a quarter of which is the character column;
; byte 1 = row in pixel lines, an eighth of which is the character row.  A cell's
; screen address is SCRTOP + charRow * SCRROW + charCol, matching DRAWALL.
;
; Glyphs are drawn straight into TILBUF ring slots, published immediately; a
; mirrored glyph is bit-reversed through LFD00 (undoing the font's pre-reversal,
; so it shows flipped).
;
; PRINTSTR takes R0 -> a string whose first two bytes are the packed position
; (a $D619 message).  PRINTAT takes R0 -> a string with no header plus an
; explicit R1 = character column, R2 = character row -- for the $D631 messages,
; whose position comes from the $D7CE table instead.  PRINTGAME (below,
; ROBINCOR.MAC's own addition -- no ZX counterpart) takes the same R0/R1/R2
; as PRINTAT but draws into the gameplay area instead of the HUD/border.
;
; All three share one glyph-stream walker (end/CR/mirror-toggle, the
; attribute-stream lockstep cursor below) and differ only in how a single
; glyph's pixels+attribute actually get committed to the screen -- that one
; step goes through a single self-modified CALL (PRTSINK names its operand
; word, not a label -- a label there would start a new local-label scope
; and break the 30$/40$/etc. references around it) that the entry point
; patches to the active sink's address before the shared loop runs, same
; spirit as the ZX original's own self-modified glyph-drawer dispatch in
; $C585.
;
; PRTCOMMITTIL (PRINTSTR/PRINTAT's sink) publishes straight into a TILBUF
; ring slot, immediately -- fine for HUD/border text: fixed position, drawn
; once, never occluded by anything else.  PRTCOMMITSHADOW (PRINTGAME's sink)
; instead writes SHADOWPIX/SHADOWATR directly, like DRAWBLOCK, and marks the
; cell dirty for DRAWALL -- required for anything drawn inside the gameplay
; area, so it flows through the normal redraw/flush pipeline (and the right
; attribute-byte convention) instead of a one-shot overwrite that a later
; DRAWALL flush would silently erase.
;
; Utilize R0-R5 throughout.

PRTATTR = 004			; fallback attribute when the string carries none

PRINTSTR:
	CLR	R1
	BISB	(R0)+, R1		; position byte 0 = column
	ASR	R1
	ASR	R1			; / 4 = character column
	CLR	R2
	BISB	(R0)+, R2		; position byte 1 = row, in pixel lines
	ASR	R2
	ASR	R2
	ASR	R2			; / 8. = character row
PRINTAT:
	MOV	R1, PRTCOL0
	MOV	R1, PRTCOL
	MOV	R2, PRTCROW
	MOV	#SCRTOP, R3
	ADD	R1, R3			; + the character column
	TST	R2
	BEQ	20$
10$:	ADD	#SCRROW, R3		; + character row * SCRROW
	SOB	R2, 10$
20$:	MOV	R3, PRTPOS		; where the next cell goes
	MOV	R3, PRTROW		; and the start of the current row
	MOV	#PRTCOMMITTIL, PRTSINK
	BR	PRTSETUP

PRINTGAME:
	MOV	R1, PRTCOL0
	MOV	R1, PRTCOL
	MOV	R2, PRTCROW
	MOV	#PRTCOMMITSHADOW, PRTSINK
	; PRTPOS/PRTROW stay stale -- PRTCOMMITSHADOW never reads them
	BR	PRTSETUP

; PRINTERASE -- same string/column/row as the PRINTGAME call that drew an
; icon, but its sink (PRTCOMMITERASE) XORs the glyph pixels back off
; instead of setting them, and never touches DIRTYCELLS/attribute at all.
; XOR is what makes this safe regardless of what else is drawn over the
; icon's cells in the meantime (Robin's own sprite, say): bg^S^F^F = bg^S,
; the same font bytes toggled a second time cancel only what they
; themselves set, with no dependency on draw order the way a direct
; overwrite would have.
PRINTERASE:
	MOV	R1, PRTCOL0
	MOV	R1, PRTCOL
	MOV	R2, PRTCROW
	MOV	#PRTCOMMITERASE, PRTSINK
;
PRTSETUP:
	CLR	PRTMIR
	MOVB	#PRTATTR, PRTLAST	; last-seen attribute, until the stream gives one
; find the attribute stream: it begins one byte past the glyph terminator
	MOV	R0, R3
25$:	TSTB	(R3)+
	BNE	25$
	MOV	R3, PRTATTP
;
; glyph loop -- shared by every sink
;
30$:	CLR	R1
	BISB	(R0)+, R1		; next byte of the glyph stream
	BNE	31$			; 000 => end (JMP: PRTCOMMITTIL/SHADOW sit
	JMP	PRTDONE			; between here and there, out of BEQ's range)
31$:	CMP	R1, #1			; 001 -- carriage return, down one row
	BNE	40$
; Resync the attribute cursor onto the next row: the ZX attribute pass runs
; independently, so a row may carry more or fewer attribute bytes than glyphs.
; Skip any leftover attributes of this row, then step past the 377 separator.
	MOV	PRTATTP, R3
32$:	MOVB	(R3), R2
	BEQ	35$			; 000 => attribute stream ended
	INC	R3
	CMPB	R2, #377
	BNE	32$			; not the separator yet
35$:	MOV	R3, PRTATTP
	ADD	#SCRROW, PRTROW		; the next character row down (PRTCOMMITTIL)
	MOV	PRTROW, PRTPOS
	MOV	PRTCOL0, PRTCOL	; and back to the start column (PRTCOMMITSHADOW)
	INC	PRTCROW
	BR	30$
40$:	CMP	R1, #2			; 002 -- mirror the following glyphs
	BNE	45$
	MOV	#1, PRTMIR
	BR	30$
45$:	CMP	R1, #3			; 003 -- stop mirroring
	BNE	50$
	CLR	PRTMIR
	BR	30$
50$:	CMP	R1, #40
	BLO	30$			; any other control byte -- skip it
;
; commit one glyph: R1 -> the glyph's 8. font bytes, sink-specific from here
;
	ASL	R1
	ASL	R1
	ASL	R1			; glyph code * 8.
	ADD	#FONTBASE, R1		; -> the glyph's 8. pixel bytes
PRTSINK = . + 2
	CALL	@#000000
	INC	PRTPOS			; both harmless to the sink that ignores them
	INC	PRTCOL
	BR	30$

; PRTCOMMITTIL -- publish one glyph into a fresh TILBUF ring slot.
; R1 -> the glyph's 8. font bytes.  Utilizes R1-R5.
;
PRTCOMMITTIL:
	CALL	CLAIMSLOT		; R4 -> the slot's pixel area
	MOV	R4, R5			; keep the slot start
	MOV	#8., R2
60$:	CLR	R3
	BISB	(R1)+, R3		; a font byte
	TST	PRTMIR
	BEQ	65$
	MOVB	LFD00(R3), R3		; mirrored => bit-reverse it back
65$:	MOVB	R3, (R4)+
	SOB	R2, 60$
; the cell attribute -- one from the stream, else the last real one seen
	MOV	PRTATTP, R3
	MOVB	(R3), R1
	BEQ	70$			; 000 => stream exhausted
	CMPB	R1, #377
	BEQ	70$			; 377 => row ran short, this row has no more
	MOVB	R1, (R4)
	MOVB	R1, PRTLAST		; remember it for any short cells that follow
	INC	PRTATTP
	BR	80$
70$:	MOVB	PRTLAST, (R4)
80$:	MOV	PRTPOS, -2(R5)		; publish: the screen address goes in last
	RETURN
;
; PRTCOMMITSHADOW -- write one glyph straight into SHADOWPIX at (PRTCROW,
; PRTCOL), colour via DIRTYCELLS rather than SHADOWATR.  R1 -> the glyph's
; 8. font bytes.  Utilizes R0-R4.
;
; Deliberately NOT the DRAWBLOCK/room-scenery convention (real SHADOWATR):
; SHADOWATR is also what CANMOVE's collision probes read as "is this cell a
; wall" (any non-zero attribute blocks a step) -- an icon writing there
; would make itself an obstacle Robin could never walk onto, contradicting
; the whole point of a pickup.  Sprites already have the answer: DRAWCELL's
; own $00-shadow-attr fallback reads DIRTYCELLS as the cell's colour
; whenever SHADOWATR is 0, so writing colour there (like DRAWSPRITE's own
; ramp stamp does) gets a correctly-coloured, collision-transparent icon
; for free -- one MOVB below serves as both "needs a flush" and "colour",
; the same dual role DIRTYCELLS already has, so MARKDIRTY is not called
; here (it would stomp that colour byte down to a bare 1).
;
PRTCOMMITSHADOW:
	MOV	PRTCROW, R4
	SWAB	R4
	CLRB	R4			; row * 400 (256.); SWAB also pulls in the
					; old high byte (0) -- drop it
	ADD	PRTCOL, R4
	ADD	#SHADOWPIX, R4		; -> this cell's pixel base
	MOV	#8., R2
60$:	CLR	R3
	BISB	(R1)+, R3		; a font byte
	TST	PRTMIR
	BEQ	65$
	MOVB	LFD00(R3), R3		; mirrored => bit-reverse it back
65$:	MOVB	R3, (R4)
	ADD	#PLAYW, R4		; next pixel line
	SOB	R2, 60$
; the cell attribute -- one from the stream, else the last real one seen
	MOV	PRTATTP, R3
	MOVB	(R3), R1
	BEQ	70$			; 000 => stream exhausted
	CMPB	R1, #377
	BEQ	70$			; 377 => row ran short, this row has no more
	MOVB	R1, PRTLAST		; remember it for any short cells that follow
	INC	PRTATTP
	BR	80$
70$:	MOVB	PRTLAST, R1
80$:	MOV	PRTCROW, R4
	ASH	#5., R4			; row * 40 (32.), matching MARKDIRTY's indexing
	ADD	PRTCOL, R4
	ADD	#DIRTYCELLS, R4
	MOVB	R1, (R4)		; colour + dirty flag in one write (see above)
	RETURN
;
; PRTCOMMITERASE -- XOR one glyph's pixels back off at (PRTCROW,PRTCOL),
; the exact inverse of PRTCOMMITSHADOW's own draw, via the same SPRXOR
; helper DRAWSPRITE uses (R0 = byte to XOR, R3 = address; preserves R4).
; Never touches DIRTYCELLS/attribute -- only MARKDIRTY, so the flush that
; picks this cell up leaves whatever colour was already there (typically 0
; by now anyway: DRAWCELL clears DIRTYCELLS after every flush, and an icon
; is only ever flushed once, at room entry).  R1 -> the glyph's 8. font
; bytes.  Utilizes R0-R4.
;
PRTCOMMITERASE:
	MOV	PRTCROW, R4
	SWAB	R4
	CLRB	R4			; row * 400 (256.)
	ADD	PRTCOL, R4
	ADD	#SHADOWPIX, R4		; -> this cell's pixel base
	MOV	#8., R2
60$:	CLR	R5			; a font byte, kept in R5 -- R0 is the shared
	BISB	(R1)+, R5		; loop's string pointer, must survive this
	TST	PRTMIR
	BEQ	65$
	MOVB	LFD00(R5), R5		; mirrored => bit-reverse it back
65$:	MOV	R0, -(SP)		; SPRXOR wants the byte in R0 -- save the
	MOV	R1, -(SP)		; string pointer, and the font pointer
	MOV	R5, R0			; (SPRXOR also clobbers R1), around it
	MOV	R4, R3
	CALL	SPRXOR			; XORs R0's low byte into (R3)
	MOV	(SP)+, R1
	MOV	(SP)+, R0
	ADD	#PLAYW, R4		; next pixel line
	SOB	R2, 60$
;
	MOV	R0, -(SP)		; MARKDIRTY wants R0/R1 -- save the string
	MOV	PRTCOL, R0		; pointer first
	MOV	PRTCROW, R1
	CALL	MARKDIRTY
	MOV	(SP)+, R0
	RETURN
PRTDONE:
90$:	RETURN

;------------------------------------------------------------------------------
; Claim the next free TILBUF record -- the ring-slot half of DRAWCELL, shared
; through the same TLBUFA cursor.  Spins until the PPU has consumed the slot.
; Returns R4 -> the slot's pixel area, past the screen-address word.
; Utilizes R4.

CLAIMSLOT:
	MOV	TLBUFA, R4
	ADD	#10., R4		; on to the next record
	CMP	R4, #TLBUFE
	BLO	10$
	MOV	#TILBUF, R4
10$:	TST	(R4)			; is it free?
	BNE	10$			; no => wait for the PPU
	TST	(R4)+			; skip the screen-address word
	MOV	R4, TLBUFA
	RETURN

;------------------------------------------------------------------------------
; Draw a class 2-3 sprite frame into the shadow screen, XORed -- the port of
; the width-class-under-4 path through the ZX routine at $C6D6 ($C723 plot
; loop, $C74D shift, $C8B7 mirror).  The class-6 path ($C585 / $9AB3 glyph
; font) is not ported.
;
; A frame is [width class][row count][pad] then row count rows of "width class"
; pixel bytes (2 or 3).  Each row is bit-reversed already (UKNC order); it is
; placed at bit offset 2*(X AND 3) inside a 4-byte window and XORed into the
; shadow bitmap at SHADOWPIX + Y*PLAYW + byte column, one pixel line per row.
;
; X is in units of 2 pixels, matching $C6D6; byte column is (X - 8) / 4, and a
; sprite with X < 8 wraps to the far right and one line up (the screen-edge
; wrap).  Drawing the same frame at the same place again erases it (XOR).
;
; The covered cells are marked dirty so DRAWALL flushes them.
;
; Input: R0 -> the frame data, R1 = X (2-pixel units), R2 = Y (pixels),
;        R3 non-zero to mirror.  Utilizes R0-R5 and SPRxxx below.
;
; DRAWFRAME (below, just before DRAWSPRITE) is the front end -- the head of
; $C6D6.  It takes a frame NUMBER and one of the three pointer-table bases,
; looks the frame data up, derives the mirror flag from bit 7 of the number,
; then falls straight into DRAWSPRITE.

;------------------------------------------------------------------------------
; Draw sprite frame NUMBER -- the head of $C6D6.  Looks the frame data up in
; the pointer table, derives the mirror flag from bit 7 of the number, and
; falls into DRAWSPRITE.
;   R0 = frame number (bit 7 selects the mirrored variant)
;   R1 = pointer-table base -- L8D80 / L8DC4 / L8DEA (what the ZX patches into
;        $C6D8; the alternate bases are just L8D80 + an offset)
;   R2 = X (2-pixel units), R3 = Y (pixels).  Utilizes R0-R5.

DRAWFRAME:
	MOV	R0, R4			; keep the number for the mirror test
	BIC	#^C177, R0		; table index -- bits 0-6
	ASL	R0			; two bytes per entry
	ADD	R1, R0
	MOV	(R0), R0		; R0 -> the frame data
	MOV	R2, R1			; R1 = X
	MOV	R3, R2			; R2 = Y
	CLR	R3
	BIT	#200, R4		; number bit 7 => draw the mirrored variant
	BEQ	DRAWSPRITE
	INC	R3
;	fall through

DRAWSPRITE:
	MOV	R3, SPRMIR
	CLR	R3
	BISB	(R0)+, R3		; byte 0 -- width class in the low nibble
	BIC	#^C17, R3
	MOV	R3, SPRW
;
; shadow address of the first row: SHADOWPIX + Y*PLAYW + byte column.  Shared
; by narrow and wide-glyph frames alike -- a glyph cell is exactly one
; shadow byte (8. pixels) wide, so this needs no extra sub-cell shift there.
;
	CLR	R5
	MOV	R2, R4			; Y
	BEQ	20$
10$:	ADD	#PLAYW, R5		; Y * PLAYW
	SOB	R4, 10$
20$:	MOV	R1, R4
	SUB	#8., R4			; X - 8., X being in 2-pixel units
	BGE	30$
	SUB	#PLAYW, R5		; X < 8. => wrap one pixel line up
30$:	ASR	R4
	ASR	R4			; / 4 = byte column
	BIC	#^C37, R4		; on the 32.-byte shadow line
	MOV	R4, SPRDC0		; keep it for the dirty marks
	ADD	R4, R5
	ADD	#SHADOWPIX, R5
	MOV	R5, SPRADR
;
	CMP	SPRW, #6		; wide-glyph class -- no 3-byte header, no
	BNE	15$			; row-tuple pixel data; a separate draw path
	JMP	GLYPHDRAW		; (too far for BEQ's branch range)
15$:
;
	CLR	R3
	BISB	(R0)+, R3		; byte 1 -- row count
	MOV	R3, SPRROWS
	CLR	R3
	BISB	(R0)+, R3		; byte 2 -- flag byte (colour + repeat bits)
	MOV	R3, SPRFLAG
	MOV	R0, SPRSRC		; -> the first pixel row
; ramp start for the cell-colour stamp: L8E12[(flag << 1) AND 0177]
	ASL	R3
	BIC	#^C177, R3
	ADD	#L8E12, R3
	MOV	(R3), SPRRAMP
	MOV	#4, SPRDCN		; footprint is 4. cells wide
;
	MOV	R1, R3
	BIC	#^C3, R3		; X AND 3
	ASL	R3			; * 2 = the sub-cell shift, in bits
	MOV	R3, SPRSHF
;
; the character-row span, for the dirty marks
;
	MOV	R2, R3
	ASR	R3
	ASR	R3
	ASR	R3			; Y / 8. = first character row
	MOV	R3, SPRDR0
	MOV	R2, R3
	ADD	SPRROWS, R3
	DEC	R3
	ASR	R3
	ASR	R3
	ASR	R3			; last character row
	MOV	R3, SPRDR1
;
; plot the rows
;
40$:	TST	SPRROWS
	BNE	41$
	JMP	RAMPSTAMP		; GLYPHDRAW sits between here and the ramp
					; stamp now -- out of BEQ's branch range
41$:	DEC	SPRROWS
;
; fetch this row's source bytes into SPRB0..SPRB2
;
	MOV	SPRSRC, R2
	CLR	R0
	BISB	(R2)+, R0		; top byte
	CLR	R1
	BISB	(R2)+, R1		; middle byte
	CLR	R3
	CMP	SPRW, #3
	BLT	42$
	BISB	(R2)+, R3		; bottom byte, class 3 only
42$:	MOV	R2, SPRSRC		; -> the next row
	TST	SPRMIR
	BEQ	48$
	MOVB	LFD00(R0), R0		; mirrored: reverse each byte and the order
	BIC	#^C377, R0		; MOVB sign-extends -- keep the low byte only
	MOVB	LFD00(R1), R1
	BIC	#^C377, R1
	MOVB	LFD00(R3), R3
	BIC	#^C377, R3
	MOV	R3, SPRB0
	MOV	R1, SPRB1
	MOV	R0, SPRB2
	BR	50$
48$:	MOV	R0, SPRB0
	MOV	R1, SPRB1
	MOV	R3, SPRB2
;
; Place the row at the sub-cell offset.  The pixel data is bit-reversed (bit 0
; = leftmost pixel), so moving the sprite right on screen is a LEFT shift of
; the 32-bit field [ 00 : b2 : b1 : b0 ], b0 in the low byte.  R4 = b1:b0,
; R5 = 00:b2; shift {R5:R4} left by SPRSHF bits.
;
50$:	MOV	SPRB0, R4
	MOV	SPRB1, R0
	SWAB	R0
	BIS	R0, R4			; R4 = b1 : b0
	MOV	SPRB2, R5		; R5 = 00 : b2
	MOV	SPRSHF, R3
	BEQ	60$
52$:	CLC
	ROL	R4
	ROL	R5
	SOB	R3, 52$
;
; XOR the four output bytes into the shadow row, low end first
;
60$:	MOV	SPRADR, R3
	MOV	R4, R0			; o0 = b0, shifted
	CALL	SPRXOR
	INC	R3
	MOV	R4, R0
	SWAB	R0			; o1 = b1, shifted, + b0 spill
	CALL	SPRXOR
	INC	R3
	MOV	R5, R0			; o2 = b2, shifted, + b1 spill
	CALL	SPRXOR
	INC	R3
	MOV	R5, R0
	SWAB	R0			; o3 = b2 spill
	CALL	SPRXOR
;
	ADD	#PLAYW, SPRADR		; next pixel line
	BR	40$
;
; Wide-glyph frames -- the port of $C585/$C5E4/$C648, minus the attribute
; blend ($C648 is deliberately not ported; the uniform ramp stamp below
; substitutes for it, same as for narrow frames, so a glyph frame's own
; attribute bytes are never read here regardless of which of the two
; attribute layouts the frame data actually carries).
;
; A 5-row x 6-column grid of glyph codes (0 = blank cell) starts right after
; the header byte already consumed above (R0).  Each glyph is a whole 8x8
; shadow cell -- one byte wide per pixel line, same as SPRADR/SPRDC0 above --
; so cells need no sub-cell shift, just a plain XOR of the 8. font bytes at
; FONTGBASE + code*8. into 8. consecutive shadow pixel lines.
;
; Mirrored frames -- both a cell-order swap (read column 5-i of the row
; where an unmirrored frame reads column i, substituting for $C682) and a
; per-glyph LFD00 bit-reverse (same convention narrow frames use for
; SPRMIR), so the whole 6x5 grid comes out as a true horizontal mirror --
; ZX's own glyph drawer skips the per-glyph reverse (its mirrored poses
; reuse the same-orientation glyphs, just rearranged), but that mechanism
; is explicitly unconfirmed in the disassembly, so this port mirrors for
; real instead of chasing an uncertain byte-exact match.
;
; Anchor correction: the 6x5 grid is drawn 1. cell left and 1. row up from
; the raw X/Y SPRADR/SPRDC0 above (2. cells left when mirrored) -- centers
; the wider glyph sprite on the same anchor point narrow frames use,
; instead of anchoring at its own top-left corner.  Tuned empirically
; against the sit-frame anchor (ZX $C585's own -3/-4 cell constants don't
; carry over -- this port's SPRDC0/SPRADR baseline differs from theirs).
;
GLYPHDRAW:
	SUB	#1, SPRDC0
	SUB	#1, SPRADR
	TST	SPRMIR
	BEQ	201$
	DEC	SPRDC0			; mirrored: one cell further left
	DEC	SPRADR
201$:	BIC	#^C37, SPRDC0		; re-wrap onto the 32.-byte shadow line
	SUB	#<8.*PLAYW>, SPRADR	; and one character row up
;
	CLR	R3
	MOV	R3, SPRFLAG		; glyph frames: flat colour, no ramp step
	ADD	#L8E12, R3
	MOV	(R3), SPRRAMP
	MOV	#6, SPRDCN		; footprint is 6. cells wide
;
	MOV	R2, R3
	ASR	R3
	ASR	R3
	ASR	R3			; Y / 8. = first character row
	DEC	R3			; matches the row-up anchor shift above
	MOV	R3, SPRDR0
	ADD	#4, R3			; 5. character rows tall
	MOV	R3, SPRDR1
;
	MOV	#5, GLYROWS
	MOV	R0, GLYROWSRC		; -> the grid's first row of 6. glyph codes
	MOV	SPRADR, GLYROWADR
;
200$:	TST	GLYROWS
	BEQ	RAMPSTAMP		; done -- shared ramp stamp
205$:
	DEC	GLYROWS
	MOV	#6, R5			; columns left in this row
	MOV	GLYROWADR, R4		; walking cell address, this row
210$:	TST	R5
	BEQ	260$
	DEC	R5
	TST	SPRMIR
	BEQ	220$
	MOV	R5, R3			; mirrored: column 5-i, i.e. index R5 itself
	BR	225$
220$:	MOV	#5, R3
	SUB	R5, R3			; unmirrored: column i, i.e. index 5-R5
225$:	MOV	GLYROWSRC, R2
	ADD	R3, R2
	CLR	R1
	BISB	(R2), R1		; the glyph code -- 0 = blank cell
	BEQ	250$
	ASL	R1
	ASL	R1
	ASL	R1			; code * 8. bytes per glyph
	ADD	#FONTGBASE, R1
	MOV	R1, R2			; -> the glyph's 8. font bytes
	MOV	#8., GLYPIXCNT
	MOV	R4, R3			; this cell's shadow byte, current pixel row
230$:	CLR	R0
	BISB	(R2)+, R0		; next font byte
	TST	SPRMIR
	BEQ	232$
	MOVB	LFD00(R0), R0		; mirrored: bit-reverse this glyph row too
	BIC	#^C377, R0		; MOVB sign-extends -- keep the low byte only
232$:	CALL	SPRXOR			; XOR into (R3); clobbers R0, R1
	ADD	#PLAYW, R3
	DEC	GLYPIXCNT
	BNE	230$
250$:	INC	R4			; next cell, one shadow byte to the right
	BR	210$
260$:	ADD	#6, GLYROWSRC		; next grid row's 6. glyph codes
	MOV	#PLAYW, R3
	ASL	R3
	ASL	R3
	ASL	R3			; * 8. pixel lines per cell
	ADD	R3, GLYROWADR
	BR	200$
;
; stamp the cell-colour ramp into DIRTYCELLS over the footprint -- the port of
; $C790.  SPRDC0 .. SPRDC0+SPRDCN-1 across SPRDR0 .. SPRDR1.  The ramp cursor
; runs continuously; flag bit 7 steps it per cell, bit 6 per row, neither =>
; flat.  Shared by narrow frames (SPRDCN=4) and wide-glyph frames (=6).
;
RAMPSTAMP:
80$:	MOV	SPRRAMP, R5		; running ramp cursor
	MOV	SPRDR0, R1
82$:	CMP	R1, SPRDR1
	BGT	90$
	MOV	R1, R2
	ASH	#5., R2			; row * 32.
	ADD	SPRDC0, R2
	MOV	SPRDCN, R3
84$:	MOVB	(R5), DIRTYCELLS(R2)	; the cell's colour, from the ramp
	BIT	#200, SPRFLAG		; bit 7 => step the ramp per cell
	BEQ	85$
	INC	R5
85$:	INC	R2
	SOB	R3, 84$
	BIT	#100, SPRFLAG		; bit 6 => step the ramp per row
	BEQ	86$
	INC	R5
86$:	INC	R1
	BR	82$
90$:	RETURN

; XOR the low byte of R0 into the byte at (R3).  Utilizes R0, R1.
; (R4 and R5 hold the row's shifted bytes across all four calls, so this must
; not touch them.)
SPRXOR:
	BIC	#^C377, R0
	CLR	R1
	BISB	(R3), R1
	XOR	R0, R1
	MOVB	R1, (R3)
	RETURN

;------------------------------------------------------------------------------
; Object table -- the port of the ZX 11-byte animation record (Robin's own is
; at $CC7C; guards $AC13, Sheriff $B8FB, boars $DD05 share the layout).  OBJSTEP
; below is the port of $C8F7.
;
; Byte offsets (raw, no named constants):
;    0   countdown; each OBJSTEP decrements it, -1 deactivates the record
;    1   per-actor scratch.  Robin: bits 0-1 = walk phase, bit 7 = facing left
;    2,3 frame-list pointer (unused until the frame-list walker lands)
;    4   status flags: bit 0 (001) active
;                      bit 1 (002) erase armed -- redraw current frame to rub out
;                      bit 2 (004) step requested -- promote the next frame
;                      bit 5 (040) hit
;    5,6,7    current frame number (bit 7 = mirror), X (2-pixel units), Y (pixels)
;    8,9,10   next frame number, X, Y -- the caller fills these and sets bit 2

NOBJ	= 6.			; Robin + up to 5 guests
; 11. bytes of real fields + 1 pad byte.  OBJSZ must be EVEN: entries are
; laid out back-to-back starting at OBJTAB (itself .EVEN below), so an
; odd OBJSZ would put every odd-numbered slot's own base at an odd
; address -- and this record has word fields at offset 2/3 (frame-list
; pointer) written directly (e.g. "MOV #sometable, 2(R4)"), which traps
; as an illegal unaligned access.
OBJSZ	= 12.

	.EVEN				; keep every entry's word fields (2/3, 8/9-as-word...)
					; at a consistent, even-safe offset from OBJTAB
OBJTAB:		.BLKB	NOBJ*OBJSZ
ROBIN	= OBJTAB		; entry 0 is Robin

;TICKODD:	.WORD	0	; flips every frame; Robin advances on every other one

RSPAWNX	= 64.			; ZX-confirmed live: $40
RSPAWNY	= 80.			; ZX-confirmed live: $50

;------------------------------------------------------------------------------
; Tiny PRNG -- a 16-bit Galois LFSR (taps x^16+x^14+x^13+x^11+1), standing in
; for the ZX's $CE6D "stir the R register" trick: the UKNC has no equivalent
; free-running noise source to sample, so this is a real generator instead.
; Period up to 65535.; the seed must stay non-zero, hence RNGINIT's guard.

; Reseed from the live frame counter, so each run differs.  Call once at boot,
; after CPUVSY so FRAMES is actually ticking.  Utilizes R0.
RNGINIT:
	MOV	FRAMES, R0
	BNE	10$
	INC	R0			; keep the seed non-zero
10$:	MOV	R0, RNGSEED
	RETURN

; R0 := next pseudo-random byte (0-377 octal), advances RNGSEED.
; Utilizes R0, R1.
PRNG:
	MOV	RNGSEED, R0
	CLC
	ROR	R0			; logical shift right -- old bit 0 -> C
	BCC	10$
	MOV	#46080., R1		; the LFSR tap mask, XORed in on a 1 bit out
	XOR	R1, R0
10$:	MOV	R0, RNGSEED
	BIC	#^C377, R0		; the caller gets the low byte
	RETURN

GSPCLR:					; clear OBJSZ bytes at R4, preserving R4
	MOV	R4, -(SP)
	MOV	#OBJSZ, R0
10$:	CLRB	(R4)+
	SOB	R0, 10$
	MOV	(SP)+, R4
	RETURN

; Fill the whole table with fresh randomness -- the port of $CE0A's guard-seed
; loop.  Call once at game start, after RNGINIT.  R3 (not R1) is the loop
; counter -- CALL PRNG itself clobbers R1.  Utilizes R0, R3, R4.
GSEEDINIT:
	MOV	#GSEED, R4
	MOV	#16., R3		; 4 groups x 4 guards
10$:	CALL	PRNG
	BIC	#^C17, R0		; byte 0: random AND 0x0F
	MOVB	R0, (R4)+
	CALL	PRNG
	MOVB	R0, (R4)+		; byte 1: random, full byte
	CALL	PRNG
	BIC	#^C200, R0		; byte 2: random AND 0x80 (bit 7 only)
	MOVB	R0, (R4)+
	SOB	R3, 10$
	RETURN

; R0 := the GSEED group base address for CURROOM -- the port of $C3FA as
; called from $C278, the *respawn-target* index: room - $20 first, then
; masked.  This is deliberately offset from the room actually being
; entered -- see GROUPADRLIVE and GUARDROLL below for why that's faithful,
; not a bug on our part.  Logical shifts throughout (CLC/ROR, not ASR)
; since CURROOM - 32. can go negative for the first 32. rooms and ASR
; would sign-fill from that.  Utilizes R0, R1.
GROUPADR:
	MOV	CURROOM, R0
	SUB	#32., R0
	.REPT	2
	CLC
	ROR	R0
	.ENDR				; (room-32.) >> 2, logical
	BIC	#^C14, R0		; bits 2-3 = group*4 directly, no separate
					; >>4/&3/*4 -- the 2 low bits we ultimately
					; want just land 2 bits higher this way
	MOV	R0, R1
	ASL	R1			; group * 8.
	ADD	R1, R0			; group * 12.
	ADD	#GSEED, R0
	RETURN

; R0 := the GSEED group base address for CURROOM -- the port of $C3FA as
; called from $C291, the *live* index: plain room number, no offset.  This
; is the band actually shown/spawned this room (GGROUP below); GROUPADR's
; offset version is only ever the respawn target, never this.  Utilizes
; R0, R1.
GROUPADRLIVE:
	MOV	CURROOM, R0
	ASR	R0
	ASR	R0			; room >> 2 (CURROOM never negative, so
					; arithmetic shift is fine here)
	BIC	#^C14, R0		; bits 2-3 = group*4 directly, no separate
					; >>4/&3/*4 -- the 2 low bits we ultimately
					; want just land 2 bits higher this way
	MOV	R0, R1
	ASL	R1			; group * 8.
	ADD	R1, R0			; group * 12.
	ADD	#GSEED, R0
	RETURN

; Re-roll one room-group's 4 guard seeds -- the port of $C276's $C282-$C28F
; loop, fed from GROUPADR's offset (respawn-target) index, exactly as ZX's
; own $C278 feeds it.  Runs on every room entry, but -- because that index
; is deliberately 2 map rows away from GGROUP's live band (GROUPADRLIVE,
; used by GUARDINIT below) -- it never reshuffles the band actually being
; shown.  A quick leave-and-return keeps guards/corpses exactly where they
; were; only reaching a room 2 rows away re-rolls that original band.
; Matches observed ZX hardware behaviour (docs/Actors.md, "Room guards").
; Utilizes R0-R4.
GUARDROLL:
	CALL	GROUPADR
	MOV	R0, R4
	MOV	#4, R3
10$:	CALL	PRNG			; R0 = a fresh random byte
	CLR	R1
	BISB	(R4), R1		; XOR it into the existing byte 0...
	XOR	R0, R1
	BIC	#^C17, R1		; ...masked back to 0-15
	MOVB	R1, (R4)
	BICB	#60, 2(R4)		; clear byte 2 bits 4-5
	ADD	#3, R4			; next guard's 3-byte entry
	SOB	R3, 10$
	RETURN

; Is the guard whose GSEED entry is at R4 present in CURROOM, and if so
; which $DEAB/$DEC7/$DEE3 route entry applies?  The port of $AA31's own
; A = (home_column - room_column + 1) AND $0F test: entry 0/1/2 for Robin
; one column right of / on / one column left of the guard's home; A>=3
; means not present.
; R0 := 0-2 (route entry / presence) or a value >= 3 (absent).
; Utilizes R0, R1.
GPRESENT:
	MOV	CURROOM, R0
	BIC	#^C17, R0		; this room's column nibble
	CLR	R1
	BISB	(R4), R1		; the guard's home column (seed byte 0)
	SUB	R0, R1			; home - room
	INC	R1			; + 1
	BIC	#^C17, R1		; AND $0F
	MOV	R1, R0
	RETURN

;------------------------------------------------------------------------------
; Guard spawn on room entry, port of $C276's rebuild loop ($C337-$C36F) plus
; its four immediate $AA31 calls ($C371-$C378).  Each of the 4 OBJTAB guard
; slots is cleared; a slot whose guard is present this room (GPRESENT < 3)
; is marked active and given the walk cycle matching its GSEED bit 7, with
; bit 6 synced (port of $C353-$C364).  The four GUARDSTEP calls at the end
; then resolve the real X/visibility and do the first draw.
;
; Y = 80. is authentic: every $AC13 entry ships with +0A = $50 and nothing on
; the guard path ever writes it -- guards move purely horizontally.

; Port of $DDF0, run on every room entry just before the spawn.  Its route
; re-open rescan tests the $DEAB table, which is all-zero live (see LDEAB),
; so it reduces to: for each guard present this room, clear the patrol
; cursor's low 2 bits.  A guard not present keeps its cursor untouched.
GUARDCURCLR:
	MOV	#4., R3
	MOV	GGROUP, R4
10$:	CALL	GPRESENT
	CMP	R0, #3
	BHIS	11$
	BICB	#3, 1(R4)
11$:	ADD	#3, R4
	SOB	R3, 10$
	RETURN
;
GUARDINIT:
	CALL	GROUPADRLIVE		; GGROUP = the live band (plain index,
					; matches ZX $C291), not the respawn target
	MOV	R0, GGROUP
	CALL	GUARDCURCLR
;
	MOV	#4., R2			; 4 guard slots
	MOV	GGROUP, R3		; R3 -> this slot's GSEED entry
	MOV	#<OBJTAB+OBJSZ>, R5	; R5 -> its OBJTAB record (slot 0 is Robin)
10$:	MOV	R3, R4
	CALL	GPRESENT
	MOV	R0, R1			; GSPCLR clobbers R0 -- keep A in R1
	MOV	R5, R4
	CALL	GSPCLR
	CMP	R1, #3
	BHIS	12$			; not present this room -- leave it cleared
	MOVB	#1, 4(R4)		; active only; GUARDSTEP arms the first draw
	BITB	#200, 2(R3)		; port of $C353-$C364: walk cycle from bit 7,
	BEQ	11$			; bit 6 synced to match
	MOV	#LAC5C, 2(R4)
	BISB	#100, 2(R3)
	BR	12$
11$:	MOV	#LAC51, 2(R4)
	BICB	#100, 2(R3)
12$:	ADD	#3, R3
	ADD	#OBJSZ, R5
	SOB	R2, 10$
;
; port of $C371-$C378: four immediate $AA31 calls -- GSTEPIDX's own cycling
; touches every slot once, resolving real X/visibility and drawing before
; the room is shown.
	CALL	GUARDSTEP
	CALL	GUARDSTEP
	CALL	GUARDSTEP
	;BR	GUARDSTEP
;NOTE: fall through into GUARDSTEP

;------------------------------------------------------------------------------
; Guard movement -- the port of ZX $AA31, minus the shooting/hotspot-claim
; branch ($AB6A-$ABAD, the $BF69 table) -- out of scope for now; this
; port's version always behaves as if that shot attempt was rejected,
; same as $AA31 itself whenever the proximity/facing/random gate fails.
;
; Also simplified from $AB0C-$AB4D: ZX re-resolves which $AC13 slot a
; guard's position belongs to via a room-nibble byte separate from home
; column, because $AC13 can hold stale cross-room data mid-transition.
; This port's OBJTAB guard slots are rebuilt fresh every room entry by
; GUARDINIT, always in sync with CURROOM, so there's no stale-slot
; problem to resolve -- this always operates on the current room's own
; 4 slots directly.
;
; Guard pixel X, port of $AAFA-$AB31 (Stage 6): a fresh GPRESENT each call
; (A = 0/1/2) decides both visibility and X.  A=1 (home == room column):
; X = patrol cursor directly.  A=2 (home == room+1) with cursor<16.: X =
; cursor+112. -- the guard peeking in from its home column's own room, near
; this room's right edge.  Anything else (A=0, or A=2 with cursor>=16.): not
; drawn this frame (port of $ABF0) -- the guard is simulated across 3
; columns but only ever visible in 2.  Y stays the fixed 80. already
; established elsewhere in this port as authentic ZX behaviour.
;
; Slot cycle, port of $AA32: which of the 4 guards $AA31 touches this call.
; The counter advances every call and never skip-returns -- every call fully
; processes one guard, so each guard updates once per 4 calls.

; Port of $AA31 in full -- no separate "process one guard" entry exists in
; the real routine; $AA31 always reads its own counter (here GSTEPIDX) to
; pick the guard.  Called once per frame from GAMELOOP, AND called directly
; 4 times in a row by GUARDINIT on room entry (port of $C276's $C371-$C378,
; which calls $AA31 once per guard immediately on every room change) so a
; freshly-shown guard's real position/frame is resolved before the room is
; even painted -- GSTEPIDX's own cycling naturally touches all 4 guards
; over those 4 calls, exactly like $AA32's counter does across $C276's loop.
; Utilizes R0-R5.
GUARDSTEP:
	MOV	GSTEPIDX, R2		; 0-3 -- this call's guard slot
	INC	GSTEPIDX
	BIC	#^C3, GSTEPIDX		; wrap 0-3 -- 4 is a power of 2
;
	MOV	R2, R3
	ASL	R3
	ADD	R2, R3			; R3 = idx * 3 -- GSEED entry offset
	MOV	GGROUP, R4
	ADD	R3, R4			; R4 -> this guard's GSEED entry
;
	MOV	#OBJTAB, R5		; R5 -> this guard's OBJTAB record
	MOV	R2, R1
	INC	R1			; slot number 1-4 (0 is Robin)
6$:	ADD	#OBJSZ, R5
	SOB	R1, 6$
	MOV	R2, GFIRESLOT		; stash before the route/patrol scan reuses R2
;
	CLR	R0
	BISB	2(R4), R0		; GSEED byte 2 (flags)
	BIT	#20, R0			; bit 4 -- dead/away
	BNE	40$			; skip the patrol step, straight to frame-select
;
	CALL	GPRESENT		; R4 already -> the GSEED entry
	CMP	R0, #3.
	BHIS	40$			; not in one of the 3 live columns this frame
;
; route/direction scan, port of $AA6E-$AAD9
;
	ASL	R0			; word index into GROUTETAB
	MOV	GROUTETAB(R0), R2	; R2 -> chosen route entry's start (28 bytes,
					; scannable start-to-end -- no separate header
					; to skip: $AA6F-$AA8E indexes cursor>>2
					; straight off the entry base, and 28*4=112
					; exactly spans the 0-111 cursor range
	CLR	R1
	BISB	1(R4), R1		; the patrol cursor (byte 1)
	MOV	R1, R3
	BIC	#^C3, R3		; low 2 bits
	BEQ	10$
	MOV	#4., R0			; budget 4
	BR	11$
10$:	MOV	#3., R0			; budget 3
11$:	ASR	R1
	ASR	R1			; cursor >> 2 -- table offset into the entry
	ADD	R1, R2			; -> scan start
	MOV	R0, R3			; scan count
12$:	TSTB	(R2)
	BNE	13$			; non-zero step byte found
	INC	R2
	SOB	R3, 12$
	BR	15$			; all-zero -- direction-rotate fallback
;
13$:
	CLR	R1			; toggle GSEED byte 2's mirror bits 6-7 --
	BISB	2(R4), R1		; port of $AA9D-$AAA8's SRA/AND $C0/XOR $80:
					; new bit7 := NOT(old bit7), new bit6 :=
					; old bit7 (a rotate-with-complement, NOT a
					; plain flip of both bits -- those only
					; agree when old bit6<>bit7)
	MOV	R1, R0
	BIC	#^C200, R0		; isolate old bit7 (0 or 200)
	BEQ	16$
	MOV	#300, R0		; old bit7 set -> shifted pair = 300
	BR	17$
16$:	CLR	R0			; old bit7 clear -> shifted pair = 0
17$:	MOV	#200, R3
	XOR	R3, R0			; final bits 6-7 = shifted XOR 200
	BIC	#300, R1		; clear old bits 6-7, keep 0-5
	BIS	R0, R1			; merge in the new bits 6-7
	MOVB	R1, 2(R4)
	BR	20$
;
15$:	CALL	PRNG			; all-zero scan: ~1-in-16 chance of a
	BIC	#^C17, R0		; facing check this call, port of $AAC4's
	BNE	20$			; LD A,R / AND $0F / JR NZ
;
; port of $AAAD-$AAD7: face toward whichever side Robin is actually on, NOT
; a coin-flip -- the real rotate-through-carry sequence resolves to exactly
; this (traced bit-by-bit), via a Z80 address-arithmetic trick against $DEC7
; this port can't replicate literally.  Reuses GPRESENT's own 0/1/2 (same
; classification, freshly read since the step above may have just moved the
; home column): A=1 (Robin on the home column) leaves facing alone; A=0/2
; set bit 7 toward that side, so facing only changes when Robin crosses
; sides.
	CALL	GPRESENT
	CMP	R0, #1
	BEQ	20$
	CLR	R1
	BISB	2(R4), R1		; R1 = old byte2
	MOV	R1, R2			; keep a copy to read the OLD bit 7 from
	BIC	#300, R1		; clear bits 6-7 in the working copy
	BIT	#200, R2		; port of $AACC-$AACF's rotation: new bit 6
	BEQ	19$			; becomes the OLD bit 7 (same pattern as 13$'s
	BIS	#100, R1		; mirror-toggle) -- NOT a copy of the new bit
19$:					; 7, which would make Stage 7a's bits-equal
					; gate see a false match and skip the resync
					; it should do whenever bit 7 actually changed
	CMP	R0, #0			; A=0 -- home==room-1, Robin is to this guard's
	BNE	18$			; RIGHT -- bit 7 must be SET (increment path,
	BIS	#200, R1		; per the patrol-step fix) to walk toward him,
					; not clear/decrement (away from him)
18$:	MOVB	R1, 2(R4)
;
; patrol-cursor step, port of $AAD9-$AAF9 -- byte 2 bit 7 picks inc/dec
; of byte 1 (the 0-111. cursor); wrap carries +/-1 into byte 0 (home
; column), AND $0F.
;
20$:	CLR	R0
	BISB	2(R4), R0
	BIT	#200, R0		; port of $AAD9's BIT 7 / JR NZ: bit 7 set
	BNE	30$			; -> increment path
;
	CLR	R1			; decrement path
	BISB	1(R4), R1
	DEC	R1
	BGE	25$
	ADD	#112., R1
	CLR	R0
	BISB	(R4), R0
	DEC	R0
	BIC	#^C17, R0
	MOVB	R0, (R4)
25$:	MOVB	R1, 1(R4)
	BR	40$
;
30$:	CLR	R1			; increment path
	BISB	1(R4), R1
	INC	R1
	CMP	R1, #112.
	BLT	35$
	SUB	#112., R1
	CLR	R0
	BISB	(R4), R0
	INC	R0
	BIC	#^C17, R0
	MOVB	R0, (R4)
35$:	MOVB	R1, 1(R4)
;
; Stage 6, port of $AAFA-$AB31 -- resolve screen X (and visibility) from the
; guard's (possibly just-stepped) home column/patrol cursor, using a FRESH
; GPRESENT (A = 0/1/2) against the current room, not the one from before the
; step.  A=1 (home == room column): X = cursor directly.  A=2 (home == room+1)
; with cursor<$10: X = cursor+112, the wrap-over near this room's edge.
; Anything else (A=0, or A=2 with cursor>=$10): not visible this frame --
; simulated but not drawn, port of $ABF0.
;
40$:	CALL	GPRESENT		; R4 -> GSEED entry still valid
	CLR	R1
	BISB	1(R4), R1		; patrol cursor
	CMP	R0, #1
	BEQ	41$
	CMP	R0, #2
	BEQ	56$
	JMP	70$
56$:	CMP	R1, #16.
	BLO	57$
	JMP	70$
57$:	ADD	#112., R1
41$:	MOVB	R1, 9.(R5)		; next X
	MOVB	#80., 10.(R5)		; next Y -- always 80., faithful to ZX
;
; Stage 7a, port of $AB34-$AB67 -- frame-list state machine.  Dead (bit 4)
; leaves the frame list alone; a fresh hit (bit 5) promotes to dead and
; switches to the death sequence; otherwise, if bits 6-7 disagree (a turn is
; pending), bit 7 picks a turn lead-in and bit 6 is synced to it (port of
; $AB5B/$AB5F), so later calls see agreement and leave the walk cycle alone.
	CLR	R3
	BISB	2(R4), R3		; flags byte, held across both bit tests below
	BIT	#20, R3			; bit 4 -- already dead/away
	BEQ	58$
	JMP	60$			; leave the frame list, just redraw
58$:
	BIT	#40, R3			; bit 5 -- just hit (set by a future sword/
	BEQ	42$			; arrow hit-test, not ported yet -- inert
					; for now, wired for when it lands)
	BICB	#40, 2(R4)		; promote hit -> persistent dead
	BISB	#20, 2(R4)
	MOV	#LAC7B, 2(R5)		; death sequence, full play from the top
	JMP	60$
;
; port of $AB50-$AB53: bits 6-7 EQUAL (00 or 11) means ZX skips this reset
; entirely and goes straight to the proximity/shoot-claim check at $AB6A --
; this port's Stage 7b below does the same, via the shared 44$ entry.
42$:	MOV	R3, R0
	BIC	#^C300, R0		; isolate bits 6-7
	BEQ	44$			; 00 -- equal, skip the reset below
	CMP	R0, #300
	BEQ	44$			; 11 -- equal, skip the reset below
	BIT	#200, R3		; bit 7 -- which walk cycle this guard joins
	BEQ	43$
	MOV	#LAC67, 2(R5)
	BISB	#100, 2(R4)		; sync bit 6 to match bit 7 (both set)
	BR	44$
43$:	MOV	#LAC6B, 2(R5)
	BICB	#100, 2(R4)		; sync bit 6 to match bit 7 (both clear)
;
; Stage 7b, port of $AB6A-$ABE0 -- guard fires an arrow.  Runs every call,
; same as ZX's fallthrough from $AB53/$AB64 into $AB6A regardless of which
; branch above was taken.  R3 still holds the flags byte (bit 7 = facing)
; read at the top of Stage 7a.  Reaching 9$ with no shot fired just falls
; into 60$ below and redraws the guard's current (walk/turn) frame list, same
; as the no-shot ZX path; a fired shot instead falls in with the kneel/aim
; list already switched in, so 60$'s generic redraw covers both cases.
44$:	MOV	#ROBIN, R0
	CLR	R1
	BISB	6(R0), R1		; Robin's X, 2-pixel units
	CLR	R0
	BISB	9.(R5), R0		; guard's X, 2-pixel units
	SUB	R0, R1			; R1 = RobinX - guardX, signed
	MOV	R1, R0			; keep the sign for the facing test below
	BGE	45$
	NEG	R0
45$:	CMP	R0, #48.		; ZX's $30 range gate (2-pixel units, same
	BLT	60$			; scale as both operands) -- too close, no shot
;
	BIT	#200, R3		; facing right needs RobinX >= guardX (R1>=0);
	BEQ	46$			; facing left needs RobinX <= guardX (R1<=0)
	TST	R1
	BLT	60$
	BR	47$
46$:	TST	R1
	BGT	60$
;
47$:	TST	BOWFLAG			; arrow mode: no coin-flip, always eligible
	BNE	50$
	CALL	PRNG
	BIC	#^C1, R0
	BEQ	60$			; ~1-in-2 chance, matches ZX's LD A,R/AND 1
;
50$:	MOV	GFIRESLOT, R0		; guard 0 -> arrow object 1, guard 1 ->
	BEQ	51$			; object 2, guards 2/3 share object 3 (matches
	CMP	R0, #1			; ZX's counter-parity fold -- contention is
	BEQ	52$			; intentional, not a bug)
	MOV	#<PROJARR+6>, R1
	BR	53$
51$:	MOV	#<PROJARR+2>, R1
	BR	53$
52$:	MOV	#<PROJARR+4>, R1
53$:	TSTB	(R1)			; slot already occupied -- give up this frame,
	BNE	60$			; this IS the cooldown, no separate timer
;
	CLR	R2
	BISB	9.(R5), R2		; guard column, matches ZX's SRL SRL of (IX+9)
	ASR	R2
	ASR	R2
	BIC	#^C37, R2		; on the 32.-byte shadow line -- guard X can wrap
					; past PLAYW (patrol cursor's +112 range); stored
					; unmasked, PROJSTEP's TOGGLECELL calls would
					; write past the row into adjacent memory
	CMP	R2, #2.			; same playable-column bounds as PROJSTEP's own
	BLT	60$			; edge kill -- a guard standing right at the
	CMP	R2, #30.		; edge would otherwise spawn an arrow that dies
	BGE	60$			; in 0-1 steps, never visibly flying
	MOVB	R2, (R1)
	MOVB	#GPROJROW, 1(R1)	; fixed guard's projectile row
	BIT	#200, R3		; guard's own facing bit
	BEQ	54$
	BICB	#200, 1(R1)		; facing right -> arrow bit7 clear: same real
	MOV	#LAC6F, 2(R5)		; direction, opposite polarity; aim frame LAC6F
	BR	55$
54$:	BISB	#200, 1(R1)		; facing left -> arrow bit7 set; aim LAC75
	MOV	#LAC75, 2(R5)
55$:
; Draw the guard's own kneel/aim frame first (CALL, not 60$'s tail JMP), then
; the arrow -- PROJDRAW after would otherwise land on the same shadow bytes
; OBJSTEP's own XOR just touched and cancel it back off in this same frame.
; The arrow's Y is NOT the guard's own sprite Y (10.(R5), fixed at 80. for
; every guard) -- it is 2 cell-rows below that, matching ZX's own $ABB0-$ABB9
; bias.  Both inputs are fixed (guard Y never varies), so this is a fixed
; 96. (14. cell rows * 8.) rather than a per-call computation.
	MOV	#96., R3
	MOV	R3, -(SP)		; stash across the OBJSTEP call below
	BISB	#4, 4(R5)		; port of $ABE3 -- arm step only
	MOV	#L8DC4, R1
	MOV	R5, R4
	MOV	R5, -(SP)		; OBJSTEP clobbers R5 (its own frame-list
	CALL	OBJSTEP			; cursor scratch) -- save/restore across it
	MOV	(SP)+, R5
	CLR	R2
	BISB	9.(R5), R2		; the arrow's own draw, at the guard's resolved
	MOV	(SP)+, R3		; column; Y is the stashed cell-row*8 from above
	JMP	PROJDRAW		; (2-pixel units), R3=Y (pixels)
;
; Not-drawn tail, port of $ABF0 -- skips stages 7a/7b; the animation still
; advances (OBJSTEP's own hold-counter/cursor-walk), the list is set straight
; from bit 7 (port of $AC02-$AC0C, bit 6 untouched), and any erase armed by
; the last real draw still fires.
70$:	CLR	R0
	BISB	2(R4), R0
	BIT	#200, R0		; bit 7 set -> LAC5C (right), clear -> LAC51
	BEQ	71$			; (left) -- same mapping as GUARDINIT and 42$
	MOV	#LAC5C, 2(R5)
	BR	72$
71$:	MOV	#LAC51, 2(R5)
72$:	BICB	#4, 4(R5)		; port of $ABF1's RES 2 -- suppress the draw;
					; an erase armed by the last draw still fires,
					; from its saved frame/X/Y at offsets 5-7
	MOV	#L8DC4, R1
	MOV	R5, R4
	JMP	OBJSTEP
;
60$:	BISB	#4, 4(R5)		; port of $ABE3 -- arm step only; OBJSTEP's
					; own step block arms the erase for next call
	MOV	#L8DC4, R1		; guard frame base
	MOV	R5, R4			; OBJSTEP takes the record in R4 (R4 was the
					; GSEED entry until here)
	JMP	OBJSTEP

;------------------------------------------------------------------------------
; Boar spawn on room entry, port of $DBF8's group-select feeding $C276-style
; rebuild.  CURROOM row >= 16. (i.e. CURROOM >= 256.) is the only band with
; boars; the group is (CURROOM>>4)-16., picking one of BOARROW16-19
; (ROBINVAR.MAC).  Each of the 4 BOARTAB slots is cleared; a slot whose boar
; is present this room (BPRESENT < 3) is marked active and given the walk
; cycle matching its seed's byte 2 bit 7.
;
; Unlike GUARDINIT, this never touches byte 0/1 of the seed entries -- byte 1
; is boar roaming's own live patrol cursor (BOARROW16-19's own header
; comment), never reset here, matching the ZX's own no-reseed behaviour.
;
; Position (X/Y) is left at 0, same as GUARDINIT leaves a guard's real X to
; GUARDSTEP's own Stage 6 -- boar roaming (the equivalent resolve step) isn't
; ported yet, so a freshly spawned boar has no visible position or draw call
; until that lands.  Rooms below CURROOM 256. never reach here.

; Is the boar whose BOARROWxx entry is at R4 present in CURROOM?  Same shape
; as GPRESENT: A = (home_column - room_column + 1) AND $0F, entry 0-2
; present, >=3 absent.  Byte 0 is the seed's home-column field.
; R0 := 0-2 (present) or >= 3 (absent).  Utilizes R0, R1.
BPRESENT:
	MOV	CURROOM, R0
	BIC	#^C17, R0		; this room's column nibble
	CLR	R1
	BISB	(R4), R1		; the boar's home column (seed byte 0)
	SUB	R0, R1			; home - room
	INC	R1			; + 1
	BIC	#^C17, R1		; AND $0F
	MOV	R1, R0
	RETURN

BOARSPAWN:
	MOV	CURROOM, R0
	CMP	R0, #400		; CURROOM < 256. -- no boars in this room
	BLO	90$
	ASH	#-4., R0		; CURROOM >> 4 (CURROOM never negative, so
					; arithmetic shift is fine here)
	SUB	#16., R0		; - 16. => group 0-3 (row 16.-19.)
	ASL	R0
	ASL	R0			; group * 4.
	MOV	R0, R1
	ASL	R1			; group * 8.
	ADD	R1, R0			; group * 12.
	ADD	#BOARROW16, R0		; R0 -> this room's 4-entry seed group
;
	MOV	#4., R2			; 4 boar slots
	MOV	R0, R3			; R3 -> this slot's seed entry
	MOV	#BOARTAB, R5		; R5 -> its BOARTAB record
10$:	MOV	R3, R4
	CALL	BPRESENT
	MOV	R0, R1			; GSPCLR clobbers R0 -- keep A in R1
	MOV	R5, R4
	CALL	GSPCLR
	CMP	R1, #3
	BHIS	12$			; not present this room -- leave it cleared
	MOVB	#1, 4(R4)		; active only; boar roaming arms the first draw
	BITB	#200, 2(R3)		; walk cycle from seed byte 2 bit 7,
	BEQ	11$			; bit 6 synced to match (mirrors GUARDINIT's
	MOV	#LDD38, 2(R4)		; own $C353-style facing-sync trick)
	BISB	#100, 2(R3)
	BR	12$
11$:	MOV	#LDD31, 2(R4)
	BICB	#100, 2(R3)
12$:	ADD	#3, R3
	ADD	#OBJSZ, R5
	SOB	R2, 10$
;
; port of $C276's own 4 immediate boar-step calls, mirroring GUARDINIT's own
; tail: resolves real X/visibility and draws before the room is shown.
	CALL	BOARSTEP
	CALL	BOARSTEP
	CALL	BOARSTEP
	BR	BOARSTEP
90$:	RETURN

;------------------------------------------------------------------------------
; Boar movement -- the port of the ZX $DC00-$DD04 region.  A near-subset of
; guard movement ($AA31 above): same 3-column presence window, same bit 6/7
; direction-toggle, same cursor-wrap-carries-into-home-column mechanic, same
; Stage 6 visibility/X resolve -- but no route-scan table (boars have no
; $DEAB equivalent -- confirmed absent by direct trace), no shooting, and no
; turn/death frames (LDD31/LDD38 are a plain 4-frame loop).
;
; Two differences from guards, both confirmed by the disasm session's trace:
;   - the patrol cursor steps by 2, not 1 (still wraps at 112.)
;   - facing always re-aims toward Robin's side on every successful reroll
;     (~1-in-32 gate here, vs guards' ~1-in-16) -- this isn't a fallback like
;     guards' route-scan-then-Robin-chase, it's the only mechanism, since
;     there's no route table to consult first.
;
; Slot cycle, port of the ZX's own per-call counter (same shape as GSTEPIDX).

; Port of the ZX boar-movement block in full.  Utilizes R0-R5.
BOARSTEP:
	MOV	BSTEPIDX, R2		; 0-3 -- this call's boar slot
	INC	BSTEPIDX
	BIC	#^C3, BSTEPIDX		; wrap 0-3
;
	MOV	CURROOM, R0
	CMP	R0, #400		; CURROOM < 256. -- no boars in this room; the
	BHIS	1$			; group calc below would go negative and walk
	RETURN				; off BOARROW16 into unrelated memory
1$:
;
	MOV	R2, R3
	ASL	R3
	ADD	R2, R3			; R3 = idx * 3 -- BOARROWxx entry offset
	MOV	CURROOM, R4
	ASH	#-4., R4		; CURROOM >> 4 (CURROOM never negative, so
					; arithmetic shift is fine here)
	SUB	#16., R4		; - 16. => group 0-3 (row 16.-19.)
	ASL	R4
	ASL	R4			; group * 4.
	MOV	R4, R1
	ASL	R1			; group * 8.
	ADD	R1, R4			; group * 12.
	ADD	#BOARROW16, R4
	ADD	R3, R4			; R4 -> this boar's BOARROWxx entry
;
	MOV	#BOARTAB, R5		; R5 -> this boar's BOARTAB record -- unlike
	MOV	R2, R1			; OBJTAB, BOARTAB has no reserved slot 0 to
	BEQ	7$			; skip (that's what GUARDSTEP's own INC R1 is
6$:	ADD	#OBJSZ, R5		; for), so idx 0-3 maps straight to slot
	SOB	R1, 6$			; offset idx*OBJSZ, 0 additions when idx=0
7$:
;
	CALL	BPRESENT		; R4 already -> the BOARROWxx entry
	CMP	R0, #3.
	BHIS	40$			; not in one of the 3 live columns this frame
;
; direction re-aim -- always evaluated (no route table to try first), gated
; by the ~1-in-32 roll (port of the AND $1F gate).  NOT a literal port of the
; ZX calc itself: the disasm trace found "A = (RobinCol/4) + $1C - E", where E
; comes from a $1C*row-distance byproduct the session flagged as dead/unused
; -- the real formula's intent isn't fully pinned down.  This compares Robin's
; and the boar's own X directly (same shape as guards' $AAAD-$AAD7 fallback
; face-toward-Robin logic) to get the same "face whichever side Robin is on"
; result; revisit if boar facing looks wrong against the real ZX.
	CALL	PRNG
	BIC	#^C37, R0		; port of the AND $1F facing-reroll gate
	BNE	20$			; roll failed -- no re-aim this call, straight
					; to the cursor step
;
	MOV	#ROBIN, R0
	CLR	R1
	BISB	6(R0), R1		; Robin's X, 2-pixel units
	CLR	R0
	BISB	9.(R5), R0		; boar's current X, 2-pixel units
	CMP	R1, R0
	BLO	15$			; Robin left of the boar -> face left (bit7=0)
;
	CLR	R1
	BISB	2(R4), R1		; R1 = old byte2 -- port of the guard-style
	MOV	R1, R3			; rotate-toggle: new bit6 := old bit7, new
	BIC	#300, R1		; bit7 := set (facing right)
	BIT	#200, R3
	BEQ	14$
	BIS	#100, R1
14$:	BIS	#200, R1
	MOVB	R1, 2(R4)
	BR	20$
15$:	CLR	R1
	BISB	2(R4), R1		; same rotate-toggle, facing left (bit7=0)
	MOV	R1, R3
	BIC	#300, R1
	BIT	#200, R3
	BEQ	20$
	BIS	#100, R1
	MOVB	R1, 2(R4)
;
; patrol-cursor step, x2 stride, same wrap-carry shape as GUARDSTEP's 20$-35$.
20$:	CLR	R0
	BISB	2(R4), R0
	BIT	#200, R0		; bit 7 set -> increment path
	BNE	30$
;
	CLR	R1			; decrement path, step by 2
	BISB	1(R4), R1
	SUB	#2, R1
	BGE	25$
	ADD	#112., R1
	CLR	R0
	BISB	(R4), R0
	DEC	R0
	BIC	#^C17, R0
	MOVB	R0, (R4)
25$:	MOVB	R1, 1(R4)
	BR	40$
;
30$:	CLR	R1			; increment path, step by 2
	BISB	1(R4), R1
	ADD	#2, R1
	CMP	R1, #112.
	BLT	35$
	SUB	#112., R1
	CLR	R0
	BISB	(R4), R0
	INC	R0
	BIC	#^C17, R0
	MOVB	R0, (R4)
35$:	MOVB	R1, 1(R4)
;
; Stage 6 equivalent -- resolve screen X (and visibility) from the boar's
; (possibly just-stepped) home column/patrol cursor, using a FRESH BPRESENT.
; A=1 (home==room): X = cursor.  A=2 (home==room+1) with cursor<16.: X =
; cursor+112.  Anything else: not visible this frame -- simulated but not
; drawn, same as guards' port of $ABF0.
40$:	CALL	BPRESENT		; R4 -> BOARROWxx entry still valid
	CLR	R1
	BISB	1(R4), R1		; patrol cursor
	CMP	R0, #1
	BEQ	41$
	CMP	R0, #2
	BEQ	56$
	BR	70$
56$:	CMP	R1, #16.
	BLO	57$
	BR	70$
57$:	ADD	#112., R1
41$:	MOVB	R1, 9.(R5)		; next X
	MOVB	#96., 10.(R5)		; next Y -- fixed, ZX $DD05's own +0A ($60),
					; 16. lower than guards' $50 -- confirmed via
					; the disasm session's direct dump, not the
					; same constant as guards despite both being
					; fixed-forever, never-written values
;
; frame-select and drawn tail -- no turn/death state machine, just facing,
; but still ported from $DCBF-$DCD9's own "bits 6-7 agree -> skip" gate:
; reassigning the list every call (regardless of whether it changed) would
; reset OBJSTEP's own frame-list cursor back to the list's first byte before
; it ever gets a chance to walk through the other 3 -- exactly the "one
; sprite frame only" bug.  Only touch 2(R5) when a facing change is actually
; pending (bits 6/7 disagree), same shape as GUARDSTEP's own Stage 7a.
	CLR	R3
	BISB	2(R4), R3		; flags byte
	MOV	R3, R0
	BIC	#^C300, R0		; isolate bits 6-7
	BEQ	60$			; 00 -- agree, list already synced
	CMP	R0, #300
	BEQ	60$			; 11 -- agree, list already synced
	BIT	#200, R3		; disagree: pick the list from bit 7,
	BEQ	42$			; sync bit 6 to match
	MOV	#LDD38, 2(R5)
	BISB	#100, 2(R4)
	BR	60$
42$:	MOV	#LDD31, 2(R5)
	BICB	#100, 2(R4)
;
60$:	BISB	#4, 4(R5)		; arm step only; OBJSTEP's own step block
					; arms the erase for next call
	MOV	#L8DEA, R1		; boar frame base
	MOV	R5, R4			; OBJSTEP takes the record in R4
	JMP	OBJSTEP
;
; Not-drawn tail -- the animation still advances (OBJSTEP's own hold-counter/
; cursor-walk), the list is set straight from bit 7, and any erase armed by
; the last real draw still fires, same as guards' port of $ABF0.
70$:	BITB	#200, 2(R4)
	BEQ	71$
	MOV	#LDD38, 2(R5)
	BR	72$
71$:	MOV	#LDD31, 2(R5)
72$:	BICB	#4, 4(R5)		; suppress the draw
	MOV	#L8DEA, R1
	MOV	R5, R4
	JMP	OBJSTEP

;------------------------------------------------------------------------------
; Debug HUD: print CURROOM as 3 hex digits at the top-right of the play area
; (straight through PRINTSTR/TILBUF, same as the ornaments -- no shadow-screen
; or attribute-fallback involvement).  Call whenever CURROOM changes.
; Gated by DBGSHOWROOM above; HEXDIG below stays ungated -- WREATHPICKUP
; also uses it for the life-count digit.

  .IF NE DBGSHOWROOM
DBGCOL	= 32.			; play-area column
DBGROW	= 26.			; play-area top row
DBGROOM:
	.BYTE	<DBGCOL*4>, <DBGROW*8.>	; position header
	.BYTE	060,060,060, 0	; 3 glyphs (filled below) + 000 terminator
	.BYTE	004,004,004, 0	; one attribute per glyph + terminator
  .ENDC

; R0 := the ASCII hex digit for the low nibble of R0 (0-15).  Utilizes R0.
HEXDIG:
	CMP	R0, #9.
	BLE	10$
	ADD	#7, R0			; close the '9'..'A' gap
10$:	ADD	#60, R0			; + '0'
	RETURN

  .IF NE DBGSHOWROOM
; Render R0's low 12 bits as 3 ASCII hex chars at R4.  Utilizes R0, R2, R3, R4.
HEXCONV:
	MOV	R0, R2			; keep the full value across the 3 digits
;
	MOV	R2, R3
	SWAB	R3			; top byte -> low byte, in one instruction
	MOV	R3, R0
	BIC	#^C17, R0		; >> 8 -- most significant digit
	CALL	HEXDIG
	MOVB	R0, (R4)+
;
	MOV	R2, R0
	ASH	#-4., R0		; >> 4 -- middle digit
	BIC	#^C17, R0
	CALL	HEXDIG
	MOVB	R0, (R4)+
;
	MOV	R2, R0
	BIC	#^C17, R0		; low digit
	CALL	HEXDIG
	MOVB	R0, (R4)+
	RETURN

DBGROOMDRAW:
	MOV	CURROOM, R0
	MOV	#<DBGROOM+2>, R4	; -> the 3 glyph bytes
	CALL	HEXCONV
	MOV	#DBGROOM, R0
	JMP	PRINTSTR
  .ENDC

;------------------------------------------------------------------------------
; Stub title/menu screen, called from START in ROBIN1.MAC (after RUNPPU/
; CPUVSY, which START starts directly).  No real menu/options yet, just
; "PRESS FIRE KEY" (ROBININD.MAC, port-only, no ZX equivalent) on an
; otherwise blank screen, then block on FIRE -- a stand-in for "any key"
; since PPUKEY only tracks the game's own key bits.

MAINMENU:
	PPUCMW	#1			; clear the real screen via PPU command
5$:	MOV	@#PPUKEY, R0		; wait for all control keys to unpress
	BNE	5$
;
	MOV	#LB587, R0		; left ornament
	CALL	PRINTSTR
	MOV	#LB5C0, R0		; right ornament
	CALL	PRINTSTR
	MOV	#MTITLE, R0
	CALL	PRINTSTR		; print "ROBIN OF THE WOOD"
	MOV	#MCONTROLS, R0
	CALL	PRINTSTR		; print "CONTROLS:"
	MOV	#MPRESSKEY, R0		; "PRESS FIRE KEY"
	CALL	PRINTSTR
	CALL	DRAWALL
8$:	MOV	@#PPUKEY, R0
	BIT	#PKEYFR, R0
	BEQ	8$
;
	CALL	RNGINIT			; reseed the PRNG from the live frame counter
;
;NOTE: fall through into GAMEMAIN
;
;------------------------------------------------------------------------------
; New-game entry point, falls straight in from MAINMENU above.

GAMEMAIN:
	CALL	GSEEDINIT		; fill the guard seed table (ZX $CE0A)
;
	MOV	#CARRYQ, R4		; new game: empty the carry queue and every
	MOV	#8., R0			; pickup flag/counter (ZX $D3DE's own zero-fill
5$:	CLRB	(R4)+			; of $D595, extended to this port's own state)
	SOB	R0, 5$
	CLR	QUIVFLAG
	CLR	KEYFLAG
	CLR	LIVES
	CLR	SWORDFLAG
	CLR	BOWFLAG
	CLR	ARROWCOUNT
	CLR	ENTPAID
	CLR	ENTBOWCD
	CLR	ARROWHITS
	CLR	GSTEPIDX
	CLR	ROBACT			; new game: not staggering
	MOV	#17, ENERGY		; ZX default ($0F) -- not reset elsewhere, so a
					; second playthrough (after GAME OVER) would
					; otherwise start with whatever energy the
					; last one ended on
;
  .IF NE DBGGOLDMAX
	MOV	#8., R0			; fill every carry slot with gold, no shift
	MOV	#CARRYQ, R4		; needed -- they all end up the same value
1$:	MOVB	#2, (R4)+
	SOB	R0, 1$
	CALL	HUDCARRY
  .ENDC
;
	CALL	PLACEWREATH		; randomise OBJLOG's type words (ZX $D3F3/$D402)
	CALL	PLACERANDOM
;
  .IF DF DBGINITROOM		; !!DEBUG!! define DBGINITROOM = <room> above to
	MOV	#DBGINITROOM, CURROOM	; force a specific starting room; undefined
  .IFF				; (the default) picks randomly, as below
	CALL	PRNG			; pick Robin's starting room: port of $CF71's
	BIC	#^C3, R0		; third roll (the $D39A table) -- one of 4
	ASL	R0			; * 2. = word offset
	MOV	STARTROOMS(R0), CURROOM
  .ENDC
	MOV	CURROOM, TREEROOM	; ZX $D3B6 -- the start-tree decoration room
	CALL	ENTERROOM
	CALL	GUARDROLL		; re-roll this room's guard seeds (ZX $C276)
  .IF NE DBGSHOWROOM
	CALL	DBGROOMDRAW		; room number, top-right of the play area
  .ENDC
;
	;TODO: new game init
;
	MOV	#ROBIN, R4		; wipe the record, then drop Robin at a fixed cell
	MOV	#OBJSZ, R0
10$:	CLRB	(R4)+
	SOB	R0, 10$
	MOV	#ROBIN, R4
	MOVB	#3, 4(R4)		; active + erase-armed
	MOVB	#13, 5(R4)		; sitting frame at the spawn cell...
	MOVB	#RSPAWNX, 6(R4)
	MOVB	#RSPAWNY, 7(R4)
	MOVB	#13, 8.(R4)		; ...and the next slot starts there too
	MOVB	#RSPAWNX, 9.(R4)
	MOVB	#RSPAWNY, 10.(R4)
	MOV	#LSITR, 2(R4)		; frame-list cursor -> sit right
	CLRB	ROBST
;
	MOV	#13, R0			; put the sit frame on screen so the first erase is real
	MOV	#L8D80, R1
	MOV	#RSPAWNX, R2
	MOV	#RSPAWNY, R3
	CALL	DRAWFRAME
;
	CALL	GUARDINIT		; spawn this room's guards (ZX $C276)
	CALL	BOARSPAWN		; spawn this room's boars (ZX $DBF8)
;
GAMELOOP:
	MOV	FRAMES, GAMEFRAME	; remember frame number
;
	;COM	TICKODD			; 0, -1, 0, -1, ...
	;BEQ	20$			; advance Robin on every other frame only
	CALL	MOVEROBIN
	CALL	ROOMEDGE		; hand off to the next room at the L/R edge
	CALL	OBJPICKUP		; erase any pickup Robin is standing on
	CALL	ENTCHECK		; the Ent's weapon-purchase transaction
	CALL	GUARDSTEP		; one guard's movement/animation this frame
	CALL	BOARSTEP		; one boar's movement/animation this frame
	CALL	PROJSTEP		; step + redraw all 4 arrow slots (ZX $BF8A)
	CALL	ARROWHIT		; hurt Robin on a guard's-arrow hit (ZX $BDA3)
	CALL	ROBACTSTEP		; advance the critical-hit stagger, if any
20$:
	CALL	DRAWALL			; flush changed cells to the screen
;
	MOV	@#PPUKEY, R0
	BIT	#PKEYST, R0		; STOP key?
	BNE	50$

10$:	CMP	FRAMES, GAMEFRAME	; still on the same frame?
	BEQ	10$
	BR	GAMELOOP
;
50$:	CALL	CPUVSYD			; stop the frame counter, remask
	CALL	STOPPU
	JMP	FINISH

;------------------------------------------------------------------------------
; Service one animation record -- the port of the ZX $C8F7.
;   R4 -> the record, R1 = the frame-pointer-table base for DRAWFRAME.
;
; Offset 0 is a per-frame hold counter.  Each call decrements it; while it stays
; >= 0 the current next-frame slot (8) is left as it is.  When it goes -1 the
; frame-list cursor at 2/3 is walked one step -- the byte it points at becomes
; the next frame, a 377 is a jump to the 2-byte loop target that follows it --
; and the hold is reloaded with FRAMEHOLD.  Then, per the status flags: bit 1
; redraws the current frame (XOR = erase); bit 2 promotes 8/9/10 -> 5/6/7, arms
; bit 1, and draws the new current frame.  DRAWFRAME clobbers R0-R5, so R4 is
; saved around it.

FRAMEHOLD = 1			; list steps once every FRAMEHOLD+1 calls

OBJSTEP:
	MOV	R1, OBJBASE		; DRAWFRAME clobbers R1 -- stash the base
	BITB	#1, 4(R4)		; bit 0 clear => record is not live
	BEQ	90$
	DECB	(R4)			; per-frame hold counter
	BPL	10$			; still holding => keep the current next frame
;
; walk the frame-list cursor at 2/3 one step into the next-frame slot 8
;
	MOVB	#FRAMEHOLD, (R4)	; reload the hold
	MOV	2(R4), R5		; the cursor
	CLR	R0
	BISB	(R5), R0		; the frame it points at
	CMPB	R0, #377		; 377 => follow the loop target
	BNE	5$
	CLR	R0
	BISB	1(R5), R0		; loop target low byte
	CLR	R1
	BISB	2(R5), R1		; loop target high byte
	SWAB	R1
	BIS	R1, R0
	MOV	R0, R5			; cursor := loop target
	CLR	R0
	BISB	(R5), R0		; the frame there
5$:	MOVB	R0, 8.(R4)		; -> the next-frame slot
	INC	R5
	MOV	R5, 2(R4)		; store the advanced cursor
;
10$:	BITB	#2, 4(R4)		; erase armed?
	BEQ	20$
	BICB	#2, 4(R4)
	CLR	R0
	BISB	5(R4), R0		; current frame number (bit 7 = mirror)
	CLR	R2
	BISB	6(R4), R2		; current X
	CLR	R3
	BISB	7(R4), R3		; current Y
	MOV	OBJBASE, R1
	MOV	R4, -(SP)
	CALL	DRAWFRAME
	MOV	(SP)+, R4
;
20$:	BITB	#4, 4(R4)		; step requested?
	BEQ	90$
	BICB	#4, 4(R4)
	BISB	#2, 4(R4)		; arm the erase for next time
	MOVB	8.(R4), 5(R4)		; promote the next slot to current
	MOVB	9.(R4), 6(R4)
	MOVB	10.(R4), 7(R4)
	CLR	R0
	BISB	5(R4), R0
	CLR	R2
	BISB	6(R4), R2
	CLR	R3
	BISB	7(R4), R3
	MOV	OBJBASE, R1
	MOV	R4, -(SP)
	CALL	DRAWFRAME
	MOV	(SP)+, R4
90$:	RETURN

;------------------------------------------------------------------------------
; Draw (XOR-toggle) one projectile's 8x1 pixel bar and mark its cell dirty --
; the port of $BD2A's shadow-pixel half (the attribute half is skipped: no
; SHADOWATR write here, so DRAWCELL's ramp-colour fallback via DIRTYCELLS
; supplies the colour, same as any other sprite).  A thin X/Y-unit wrapper
; around TOGGLECELL below, used only at arrow launch (GUARDSTEP Stage 7b),
; which still has the guard's position in OBJTAB's own X/Y units.
;   R2 = X (2-pixel units), R3 = Y (pixels).
; Clobbers R0, R1, R2, R4.

PROJDRAW:
	MOV	R2, R0
	ASR	R0
	ASR	R0			; X >> 2 = cell column
	BIC	#^C37, R0		; on the 32.-byte shadow line -- guard X can
					; wrap past PLAYW (patrol cursor's +112 range),
					; matches DRAWFRAME's own masking
	MOV	R3, R1
	ASR	R1
	ASR	R1
	ASR	R1			; Y >> 3 = cell row
					; falls straight into TOGGLECELL, right below
;
; The shared XOR-toggle + dirty-mark, taking cell units directly -- PROJSTEP
; below stores PROJARR's column already in cell units (ZX's own SRL SRL
; scale, ported unchanged), so it calls this directly rather than going
; through PROJDRAW's extra /4.
;   R0 = cell column (0-31., already masked), R1 = cell row.
; Clobbers R1, R2, R4.

TOGGLECELL:
	SWAB	R1			; row * 256.
	MOV	R1, R2
	ADD	R0, R2			; + column
	ADD	#SHADOWPIX, R2		; now R2 = address in SHADOWPIX
	MOVB	(R2), R4
	MOV	#377, R3
	XOR	R3, R4
	MOVB	R4, (R2)
; Mark the cell yellow on black -- port of $BD2A's $E500 write of $46
	ASR	R1
	ASR	R1
	ASR	R1			; row * 32.
	ADD	R0, R1			; + column
	MOVB	#6, DIRTYCELLS(R1)	; put the yellow color
	RETURN

;------------------------------------------------------------------------------
; Step all 4 PROJARR objects one segment (horizontal only -- the row never
; changes, matching ZX's own $BCC2/$BD2A behaviour once its self-modified
; skip-erase/hit-kill flags are factored out; see the header note above
; PROJARR).  Port of $BCC2, called once per frame from GAMELOOP, not per
; guard turn like GUARDSTEP.  Object 0 (Robin's arrow) is always empty for
; now and is skipped like any other inactive slot.
;
; No skip-first-erase flag is needed here (unlike ZX): arrow creation
; already draws once (GUARDSTEP Stage 7b's PROJDRAW call), so this routine's
; first erase pass on the following frame un-draws exactly that, in balance.
; No hit-kill flag either -- nothing sets one yet, since no hit-test exists.
; Utilizes R0-R5.

GPROJROW = 12.		; Guards' projectile row

PROJSTEP:
	MOV	#PROJARR, R5
10$:	MOVB	(R5), R0		; get column 0..31, 0 = empty slot
	BEQ	90$			; => skip empty
;
	MOV	#GPROJROW, R1		; row is always fixed (see PROJARR's header)
	CALL	TOGGLECELL		; erase at the current position
;
	MOVB	(R5), R0		; get column 0..31
	BITB	#200, 1(R5)		; direction (bit 7) = right?
	BEQ	20$
	DEC	R0			; left
	BR	30$
20$:	INC	R0
30$:	CMP	R0, #2.
	BLT	40$			; off the left edge -- kill, no redraw
	CMP	R0, #30.
	BLT	50$			; still on screen
; Kill the arrow
40$:	CLR	(R5)+
	BR	95$
; Still on the screen - redraw
50$:	MOVB	R0, (R5)		; save new column
	MOV	#GPROJROW, R1
	CALL	TOGGLECELL		; draw at the new position
;
90$:	TST	(R5)+			; next object -- TOGGLECELL clobbers R4, so the
95$:	CMP	R5, #<PROJARR+8.>	; loop bound is a plain address compare, not
	BLT	10$			; SOB's own counter register
	RETURN

;------------------------------------------------------------------------------
; Robin's energy, ZX $BF6F.  The antler colour it drives ($BF37, decoded
; this session -- see docs/DisplayList.md's "Palette word format" section)
; is ROBIN1.MAC's job: STANTLER reads ENERGY itself and pushes the matching
; ANTLERTAB word to the PPU.  ENERGY never goes below 2 here -- that is ZX's
; own "critical" floor, where $BE25 diverts to a stagger/death animation
; instead of decrementing further; that branch isn't ported, so this
; stand-in just stops decrementing at 2.

;------------------------------------------------------------------------------
; Check Robin against the 3 guard's arrows -- port of $BDA3, called once per
; frame from GAMELOOP.  Object 0 (Robin's own arrow) is skipped; only
; objects 1-3 (the guard's arrows) can hurt him.  Idle gate, ZX's $CC7B
; check: skips entirely while ROBACT is non-zero, so Robin can't be hit
; again (double-triggering the stagger) while already staggering.
;
; ZX's test: (column+2)*4 - RobinX within an 8-unit band, row*8 - RobinY
; within a 24-unit band, both in the same 2-pixel-unit/pixel scale as
; Robin's own OBJTAB X/Y.  Row is always the fixed GPROJROW here (guards
; never move vertically, confirmed live: every guard's Y is RSPAWNY), so
; the Y-band test reduces to one constant per call.
;
; On a hit: clears the arrow immediately (not ZX's one-frame-delayed
; destroy-via-bit-6 -- a deliberate simplification, our PROJARR layout
; doesn't carry that flag).  Above the critical floor, decrements ENERGY
; and recolours the antlers.  At the critical floor, triggers the stagger
; (ZX $BE25/$CB9D) instead -- see ROBACTSTEP below.  Utilizes R0-R5.

ARROWHIT:
	TST	ROBACT			; already staggering -- invulnerable, ZX's
	BNE	99$			; own idle-gate behaviour
	MOV	#<PROJARR+2>, R5	; objects 1-3 -- skip object 0 (Robin's arrow)
10$:	CLR	R0
	BISB	(R5), R0		; column, 0 = empty slot
	BEQ	90$
;
	CLR	R2
	BISB	ROBIN+6, R2		; Robin's X, 2-pixel units (reloaded each
	CLR	R3			; iteration since TOGGLECELL below clobbers
	BISB	ROBIN+7, R3		; R2 -- ROBIN is a fixed address, no register
					; needed to reach it)
	MOV	R0, R1			; keep the raw column -- needed again for the
					; erase below, and TOGGLECELL clobbers R0
	ADD	#2, R0
	ASL	R0
	ASL	R0			; R0 = (column+2)*4
	SUB	R2, R0			; less Robin's X
	BLT	90$
	CMP	R0, #8.
	BGE	90$			; outside the 8-unit X band
;
	MOV	#96., R0		; the arrow's fixed row (GPROJROW*8), in pixels
	SUB	R3, R0			; less Robin's Y
	BLT	90$
	CMP	R0, #24.
	BGE	90$			; outside the 24-unit Y band
;
	MOV	R1, R0			; erase the arrow's own drawn pixel before
	MOV	#GPROJROW, R1		; clearing the slot -- CLR alone only stops
	CALL	TOGGLECELL		; PROJSTEP redrawing it next frame, it
					; doesn't erase what's already on screen
	CLR	(R5)			; hit -- clear the arrow (word clear is
					; fine, column 0 alone marks it empty)
  .IF NE DBGNODAMAG			; !!DEBUG!! arrow still clears, Robin doesn't
	BR	90$			; take it -- no ENERGY change, no stagger
  .ENDC
	CMP	ENERGY, #2
	BGT	20$			; above the critical floor -- plain damage
	MOV	#ROBACRIT, ROBACT	; at the floor -- trigger the stagger instead;
	RETURN				; ROBACTSTEP does the rest, and the idle gate
					; above stops any further hit this frame
20$:	DEC	ENERGY
	CALL	STANTLER		; ROBIN1.MAC -- reads ENERGY, pushes colour
;
90$:	ADD	#2, R5			; next object
	CMP	R5, #<PROJARR+8.>
	BLT	10$
99$:	RETURN

;------------------------------------------------------------------------------
; Advance the critical-hit stagger by one frame -- port of ZX $BE25's $6E
; branch plus $CB9D/$CBC7/$CBD6/$C055, called unconditionally once per frame
; from GAMELOOP.  No-ops immediately unless ROBACT is set (by ARROWHIT).
;
; ROBACT does double duty exactly like ZX's $CC7B: first call after being
; set to ROBACRIT is the one-shot transition (ZX $CB9D) -- lives penalty,
; pick the stagger state/frame-list by facing -- identified by ROBST not
; being 8/9 yet (the setup itself is what sets it, so this can only be true
; once).  ZX identifies the same "first call" by CC7B still reading exactly
; $6E, but ZX's version falls through into the SAME-frame decrement below
; right after the state change (via $CB9D -> $CBF7 -> $CA30's dispatch,
; landing straight on $CBC7/$CBD6) -- this does too, deliberately, rather
; than RETURNing after setup: without that fallthrough ROBACT would never
; change on the first call, and every later call would misread it as still
; being the first one, an infinite loop.  Every call after that is the real
; countdown (ZX $CBC7/$CBD6), which at the fixed checkpoint ROBACHECK (ZX
; $C055's own $3C) checks whether the lives penalty went negative and cuts
; to GAME OVER if so, pre-empting the natural recovery at 0 -- otherwise
; just keeps counting.  Utilizes R0-R2, R4.

ROBACTSTEP:
	TST	ROBACT
	BEQ	99$			; not staggering
	CMPB	ROBST, #8.
	BEQ	20$			; already staggering -- countdown path
	CMPB	ROBST, #9.
	BEQ	20$
;
	SUB	#2, LIVES		; extra-life penalty; PDP-11 signed underflow
					; wraps the same way ZX's unguarded SUB does
	CALL	DRAWLIVES		; redraw the HUD count -- matches ZX's own
					; $CBAA, called unconditionally here too,
					; even if this just went negative (briefly
					; shows a garbage digit until GAME OVER
					; cuts in at the checkpoint below)
	MOV	#ROBIN, R4
	BITB	#200, 1(R4)		; current facing (bit7: clear=right, set=left)
	BEQ	10$
	MOV	#9., R1
	MOV	#LSTAGL, R2
	BR	11$
10$:	MOV	#8., R1
	MOV	#LSTAGR, R2
11$:	MOVB	R1, ROBST
	MOV	R2, 2(R4)		; frame-list cursor, same as COMMIT
;
20$:	DEC	ROBACT
	CMP	ROBACT, #ROBACHECK
	BNE	30$
	TST	LIVES
	BLT	GAMEOVER		; negative -- pre-empts the recovery below
;
30$:	TST	ROBACT
	BNE	99$			; still counting down
	MOV	#17, ENERGY		; recovered -- refill (ZX default, $0F)
;
; Back to a normal sit state, same as TOSITF/COMMIT -- ROBST must leave 8/9
; before MOVEROBIN's gate reopens next frame, or ROBSTATE indexes RSDISP
; (only 8 entries, states 0-7) past its end and JMPs into garbage.
	MOV	#ROBIN, R4
	BITB	#200, 1(R4)		; current facing (bit7: clear=right, set=left)
	BEQ	40$
	MOVB	#1, ROBST
	MOV	#LSITL, 2(R4)
	BR	50$
40$:	CLRB	ROBST
	MOV	#LSITR, 2(R4)
50$:	JMP	STANTLER		; ROBIN1.MAC -- push the full-energy colour
99$:	RETURN

;------------------------------------------------------------------------------
; GAME OVER -- print the message (ROBININD.MAC's LB663, already ported but
; unused until now), wait for a key (same FIRE stand-in as MAINMENU), then
; back to the menu.  ZX has no in-game resurrect/respawn -- this always
; means a hard reset, never called mid-play.

GAMEOVER:
	CLR	ROBACT			; leave the stagger cleanly before the menu
	CALL	DRAWALL			; flush this frame's own pending redraws (e.g.
					; a guard GUARDSTEP already marked dirty but
					; hasn't published yet) first, so the message
					; below always publishes last and wins any
					; overlap instead of a guard punching a hole
					; back through its black background rows
	MOV	#LB663, R0		; ROBININD.MAC -- "GAME OVER" message
	CALL	PRINTSTR
	CALL	DRAWALL
8$:	MOV	@#PPUKEY, R0
	BIT	#PKEYFR, R0
	BEQ	8$
	JMP	MAINMENU

;------------------------------------------------------------------------------
; Pixel X/Y -> shadow-attribute cell address -- the port of the ZX $DDD6.
;   R2 = X (2-pixel units), R3 = Y (pixels).  Returns R0 = the cell address.
;   Clobbers R0, R1; preserves R2, R3.

ATRADDR:
	MOV	R3, R0
	ASR	R0
	ASR	R0
	ASR	R0			; Y >> 3 = character row
	MOV	R0, R1
	ASH	#5., R1			; row * 32.
	MOV	R2, R0
	ASR	R0
	ASR	R0			; X >> 2 = column
	ADD	R0, R1
	SUB	#2, R1			; the ZX -2 column bias
	ADD	#SHADOWATR, R1
	MOV	R1, R0
	RETURN

;------------------------------------------------------------------------------
; Can Robin step one cell in direction R5 (a PKEY bit) from X=R2, Y=R3?
; Port of the ZX $DD6F / $DD80 / $DD93 / $DD9F + $DDB1 / $DDC5.  Only tests on a
; cell boundary (X&3 for L/R, Y&7 for U/D); off a boundary the move is allowed.
; Probe cells are offset past Robin's leading edge exactly as the ZX does:
; blocked if any covered SHADOWATR byte is non-zero.
;   Returns R0 = 0 clear / non-zero blocked.  Clobbers R0-R3, R5.

CANMOVE:
	CMP	R5, #PKEYRT
	BEQ	10$
	CMP	R5, #PKEYLT
	BEQ	20$
	CMP	R5, #PKEYDN
	BEQ	30$
; up: Y&7 gate, 3 cells across the row at the base
	MOV	R3, R0
	BIC	#^C7, R0
	BNE	80$
	CALL	ATRADDR
	MOV	R0, R1
	MOV	#3, R2
	MOV	#1, R3
	BR	70$
; right: X&3 gate, +1 row +3 cols, 2 cells one row apart
10$:	MOV	R2, R0
	BIC	#^C3, R0
	BNE	80$
	CALL	ATRADDR
	MOV	R0, R1
	ADD	#<32.+3>, R1
	MOV	#2, R2
	MOV	#32., R3
	BR	70$
; left: X&3 gate, +1 row -1 col, 2 cells one row apart
20$:	MOV	R2, R0
	BIC	#^C3, R0
	BNE	80$
	CALL	ATRADDR
	MOV	R0, R1
	ADD	#<32.-1>, R1
	MOV	#2, R2
	MOV	#32., R3
	BR	70$
; down: Y&7 gate, +3 rows, 3 cells across
30$:	MOV	R3, R0
	BIC	#^C7, R0
	BNE	80$
	CALL	ATRADDR
	MOV	R0, R1
	ADD	#<3*32.>, R1
	MOV	#3, R2
	MOV	#1, R3
; test R2 cells from R1, stride R3
70$:	CLR	R0
72$:	TSTB	(R1)
	BEQ	74$
	INC	R0			; a tiled cell -- blocked
	RETURN
74$:	ADD	R3, R1
	SOB	R2, 72$
	RETURN				; R0 = 0, clear
80$:	CLR	R0			; not on a cell boundary => allowed
	RETURN

;------------------------------------------------------------------------------
; Advance Robin one step: read input, step the pixel position (each axis gated
; by a wall check), run the state machine to choose the frame list, then hand
; off to OBJSTEP.  The port of the ZX chain $C6A2 -> $C95A (position +
; collision) -> $C9E7/$CD42 (state) -> $C8F7 (frame).  No "changed direction
; only on a boundary" filter, no action system yet.

RSTEPX	= 2.			; X move per step, in 2-pixel units (= 4 px)
RSTEPY	= 4.			; Y move per step, in pixels
RMINY	= 8.			; X is left unclamped -- ROOMEDGE handles the sides
RMAXY	= 116.

RDIRS	= PKEYLT+PKEYRT+PKEYUP+PKEYDN

MOVEROBIN:
	MOV	#ROBIN, R4
	TST	ROBACT			; staggering (ZX $CC7B non-zero)? skip input/
	BNE	STAGTAIL		; movement/state entirely, just keep animating
	CALL	READINPUT		; R0 = key mask, opposite pairs cancelled
	MOV	R0, R2
	BIC	#^C<PKEYFR>, R2
	MOV	R2, FIREHELD
	BIC	#^C<RDIRS>, R0		; direction bits only
	MOV	R0, -(SP)		; keep for the state machine
;
; step the pixel position (offsets 9 / 10), each axis gated by CANMOVE
;
	CLR	R2
	BISB	9.(R4), R2
	MOV	R2, CMTMPX		; Robin's current X
	CLR	R3
	BISB	10.(R4), R3
	MOV	R3, CMTMPY		; Robin's current Y
;
; ZX $C95A ($C9AF-C9B4): skip position stepping entirely once ROBST reaches
; an action state (6 = stick swing and up) -- holds Robin still until the
; state machine below drives him back to a movement state.
;
	CMPB	ROBST, #6
	BHIS	9$
;
8$:	BIT	#PKEYLT, R0
	BEQ	1$
	MOV	CMTMPX, R2
	MOV	CMTMPY, R3
	MOV	#PKEYLT, R5
	CALL	CANMOVE
	TST	R0
	BNE	1$
	SUB	#RSTEPX, CMTMPX
1$:	MOV	(SP), R0
	BIT	#PKEYRT, R0
	BEQ	2$
	MOV	CMTMPX, R2
	MOV	CMTMPY, R3
	MOV	#PKEYRT, R5
	CALL	CANMOVE
	TST	R0
	BNE	2$
	ADD	#RSTEPX, CMTMPX
2$:	MOV	(SP), R0
	BIT	#PKEYUP, R0
	BEQ	3$
	MOV	CMTMPX, R2
	MOV	CMTMPY, R3
	MOV	#PKEYUP, R5
	CALL	CANMOVE
	TST	R0
	BNE	3$
	SUB	#RSTEPY, CMTMPY
3$:	MOV	(SP), R0
	BIT	#PKEYDN, R0
	BEQ	4$
	MOV	CMTMPX, R2
	MOV	CMTMPY, R3
	MOV	#PKEYDN, R5
	CALL	CANMOVE
	TST	R0
	BNE	4$
	ADD	#RSTEPY, CMTMPY
9$:
4$:	MOV	CMTMPY, R3		; clamp Y (X is ROOMEDGE's job)
	CMP	R3, #RMINY
	BGE	5$
	MOV	#RMINY, R3
5$:	CMP	R3, #RMAXY
	BLE	6$
	MOV	#RMAXY, R3
6$:	MOVB	CMTMPX, 9.(R4)
	MOVB	R3, 10.(R4)
;
	MOV	(SP)+, R0		; direction mask
	CALL	ROBSTATE		; -> ROBST, cursor at 2/3, facing bit 7 of off. 1
;
STAGTAIL:
	BISB	#5, 4(R4)		; active + step requested
	MOV	#L8D80, R1
	JMP	OBJSTEP

;------------------------------------------------------------------------------
; Robin's sit/walk state machine -- the port of the ZX $CD42 handlers for
; states 0-5 (SIT R/L, RUN R/L, RUN U/D) plus the $CB6B classifier and the
; $CBF7 commit.  R4 -> the record, R0 = the direction mask (bits: 1 right,
; 2 left, 4 down, 10 up -- the PKEY layout, which matches the ZX FUDLR order).
;
; On a state change it writes the new state to ROBST, points the record's
; cursor (2/3) at the new frame list, and sets the facing bit (offset 1 bit 7).
; "Stay" leaves the cursor running so the current list keeps animating.

; Robin's animation-code register, ZX $CC7B: 0 = normal, ROBST/ROBSTATE (the
; per-frame state machine above/below) drives him from live input as usual.
; Nonzero = a special sequence is in progress; MOVEROBIN's own gate (see its
; top) skips the whole input/movement/state machine while this is set and
; just lets the already-armed frame-list cursor keep animating through
; OBJSTEP, same as ZX locks Robin out of normal control whenever $CC7B (or
; $CC7A) is live.  The only sequence that sets it so far is the critical-hit
; stagger, ported in ROBACTSTEP below (ZX $BE25/$CB9D/$CBC7/$CBD6/$C055).
ROBACRIT = 156.		; ZX $6E -- one-shot "just critically hit" sentinel and
			; the stagger's starting countdown value, both at once
			; (ZX reuses the same register both ways; see ROBACTSTEP)
ROBACHECK = 74.		; ZX $3C -- the fixed countdown point $C055 watches to
			; decide GAME OVER vs a natural recovery at 0

RSDISP:	.WORD	RSSIT, RSSIT, RSRUNR, RSRUNL, RSRUNU, RSRUND, RSSTICK, RSSTICK

ROBSTATE:
	BIC	#^C<RDIRS>, R0
	CLR	R1
	BISB	ROBST, R1
	ASL	R1
	MOV	RSDISP(R1), R1
	JMP	(R1)

; --- states 0 / 1: sitting ---
RSSIT:	TST	FIREHELD		; fire takes precedence over movement,
	BEQ	10$			; same as the ZX action dispatch's order
	BIT	#<PKEYUP+PKEYDN>, R0
	BNE	10$			; up/down held => no swing this tick
	MOV	#20., SWINGCNT		; ZX's $CC7A = $10 (16.) load
	BITB	#200, 1(R4)		; current facing decides which list
	BEQ	11$
	MOV	#7, R1
	MOV	#LSTICKL, R2
	JMP	COMMIT			; (too far for BR's branch range)
11$:	MOV	#6, R1
	MOV	#LSTICKR, R2
	JMP	COMMIT
10$:	TST	R0
	BNE	13$
	RETURN				; no key => keep sitting (RSSTAY is just this)
13$:	BIT	#PKEYRT, R0
	BNE	TORUNR
	BIT	#PKEYLT, R0
	BNE	TORUNL
	BIT	#PKEYDN, R0
	BNE	TORUND
	BR	TORUNU			; must be up

; --- states 6 / 7: stick swing ---
RSSTICK:	DEC	SWINGCNT
	BLE	12$
	RETURN				; (RSSTAY is just this, was too far for BR)
12$:	BIT	#PKEYRT, R0
	BNE	TORUNR
	BIT	#PKEYLT, R0
	BNE	TORUNL
	BIT	#PKEYUP, R0
	BNE	TORUNU
	BIT	#PKEYDN, R0
	BNE	TORUND
	BR	TOSITF

; --- state 2: running right ---
RSRUNR:	TST	R0
	BEQ	TOSITR			; no key => sit, facing right
	BIT	#PKEYLT, R0
	BNE	TOTURNL			; left pressed => turn to running left
	BIT	#PKEYRT, R0
	BNE	RSSTAY			; still right => stay
	BIT	#PKEYUP, R0
	BNE	TORUNU
	BR	TORUND			; only up/down left, and not up => down

; --- state 3: running left ---
RSRUNL:	TST	R0
	BEQ	TOSITL
	BIT	#PKEYRT, R0
	BNE	TOTURNR
	BIT	#PKEYLT, R0
	BNE	RSSTAY
	BIT	#PKEYUP, R0
	BNE	TORUNU
	BR	TORUND

; --- state 4: running up ---
RSRUNU:	TST	R0
	BEQ	TOSITF			; no key => sit, keep the last facing
	BIT	#PKEYDN, R0
	BNE	TORUND
	BIT	#PKEYRT, R0
	BNE	TORUNR
	BIT	#PKEYLT, R0
	BNE	TORUNL
	RETURN				; up only => stay (RSSTAY is just this)

; --- state 5: running down ---
RSRUND:	TST	R0
	BEQ	TOSITF
	BIT	#PKEYUP, R0
	BNE	TORUNU
	BIT	#PKEYRT, R0
	BNE	TORUNR
	BIT	#PKEYLT, R0
	BNE	TORUNL
	RETURN				; RSSTAY is just this

; --- transitions: R1 = new state, R2 = new list, then COMMIT ---
TORUNR:	MOV	#2, R1
	MOV	#LRUNR, R2
	BICB	#200, 1(R4)		; face right
	BR	COMMIT
TORUNL:	MOV	#3, R1
	MOV	#LRUNL, R2
	BISB	#200, 1(R4)		; face left
	BR	COMMIT
TOTURNR:	MOV	#2, R1
	MOV	#LTURNR, R2
	BICB	#200, 1(R4)
	BR	COMMIT
TOTURNL:	MOV	#3, R1
	MOV	#LTURNL, R2
	BISB	#200, 1(R4)
	BR	COMMIT
TORUNU:	MOV	#4, R1
	MOV	#LRUNU, R2		; back view -- facing unchanged
	BR	COMMIT
TORUND:	MOV	#5, R1
	MOV	#LRUND, R2		; front view -- facing unchanged
	BR	COMMIT
TOSITR:	CLR	R1
	MOV	#LSITR, R2
	BICB	#200, 1(R4)
	BR	COMMIT
TOSITL:	MOV	#1, R1
	MOV	#LSITL, R2
	BISB	#200, 1(R4)
	BR	COMMIT
TOSITF:	BITB	#200, 1(R4)		; sit, whichever way offset 1 already faces
	BNE	TOSITL
	BR	TOSITR

COMMIT:	MOVB	R1, ROBST
	MOV	R2, 2(R4)		; the record's frame-list cursor
RSSTAY:	RETURN

;------------------------------------------------------------------------------
; If Robin has walked off an edge, wrap him to the opposite side and step
; CURROOM to the neighbouring room on the world map, then rebuild the room.
; The port of the four arms of the ZX edge check at $BFBA and the room step at
; $C22F.  One edge per call, same as the ZX.
;
; CURROOM is a linear world-map index: low nibble = column (0-15, wraps on the
; row), the rest = row (0-19, wraps).  ZX X and Y units carry straight over:
; off-left below 11., off-right at 122. (wrap span 110.); off-top below 40.,
; off-bottom at 112. (re-enter at Y 104. / 48.).

REDGEL	= 11.
REDGER	= 122.
REDGEW	= 110.
REDGET	= 40.
REDGEB	= 112.
REDGETY	= 104.			; Y when entering through the top edge
REDGEBY	= 48.			; Y when entering through the bottom edge
ROWSTEP	= 20			; octal: one map row in CURROOM (low nibble = column)
NROWS	= 20.

ROOMEDGE:
	MOV	#ROBIN, R4
	CLR	R2
	BISB	6(R4), R2		; Robin's current X
	CLR	R3
	BISB	7(R4), R3		; Robin's current Y
;
	CMP	R2, #REDGEL
	BLT	10$			; X < 11. => off the left
	CMP	R2, #REDGER
	BLT	20$			; not off a side
	SUB	#REDGEW, R2		; off the right: wrap to the left side
	MOV	#1, R1			; column + 1
	BR	14$
10$:	ADD	#REDGEW, R2		; off the left: wrap to the right side
	MOV	#-1, R1			; column - 1
14$:	MOVB	R2, 6(R4)		; store the wrapped X
	MOV	CURROOM, R0
	MOV	R0, R5
	BIC	#^C17, R5		; R5 = column
	ADD	R1, R5
	BIC	#^C17, R5		; wrap 0..15 (AND 017: -1 -> 15, 16 -> 0)
	BIC	#17, R0			; R0 = row part
	BIS	R5, R0
	BR	80$
;
20$:	CMP	R3, #REDGET
	BLT	30$			; Y < 40. => off the top
	CMP	R3, #REDGEB
	BLT	90$			; not off top or bottom
	MOV	#REDGEBY, R3		; off the bottom: enter from the top, row + 1
	MOVB	R3, 7(R4)
	MOV	CURROOM, R0
	ADD	#ROWSTEP, R0
	MOV	R0, R1
	BIC	#17, R1			; R1 = new row, in place
	CMP	R1, #NROWS*ROWSTEP
	BLO	80$			; row < 20 => fine
	MOV	CURROOM, R0
	BIC	#^C17, R0		; row wrapped past 19 => row 0, same column
	BR	80$
30$:	MOV	#REDGETY, R3		; off the top: enter from the bottom, row - 1
	MOVB	R3, 7(R4)
	MOV	CURROOM, R0
	SUB	#ROWSTEP, R0
	BCC	80$			; no borrow => row stayed >= 0
	MOV	CURROOM, R0
	BIC	#^C17, R0		; row was 0 => wrap to the last row, same column
	ADD	#<NROWS-1>*ROWSTEP, R0
;
80$:	MOV	R0, CURROOM
	CALL	ENTERROOM		; clears the shadow screen and redraws the room
	CALL	GUARDROLL		; re-roll this room's guard seeds (ZX $C276)
	CALL	GUARDINIT		; spawn this room's guards (ZX $C276)
	CALL	BOARSPAWN		; spawn this room's boars (ZX $DBF8)
  .IF NE DBGSHOWROOM
	CALL	DBGROOMDRAW		; room number, top-right of the play area
  .ENDC
;
	MOV	#ROBIN, R4
	BISB	#2, 4(R4)		; we redraw Robin below -- next step must erase it
	MOVB	6(R4), 9.(R4)		; keep the next slot in step with the wrapped pos
	MOVB	7(R4), 10.(R4)
	CLR	R0
	BISB	5(R4), R0		; redraw Robin's current frame on the fresh room
	CLR	R2
	BISB	6(R4), R2
	CLR	R3
	BISB	7(R4), R3
	MOV	#L8D80, R1
	JMP	DRAWFRAME
90$:	RETURN

;------------------------------------------------------------------------------
