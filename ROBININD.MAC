;------------------------------------------------------------------------------
; Branched antlers, ZX $D2C3-$D348 -- the energy display.
;
; Same message format as the icons above: glyph codes plus position and
; attribute bytes.  The glyphs are the antler halves in the font, codes
; 133-151 (upper) and 152-170 (lower), 15. each; the trailing 107 runs are
; the attribute bytes.
;
; The shape never changes -- $BF37 recolours that attribute strip from the
; energy value, so the antlers colour reflects energy rather than the art
; being redrawn.  Printed by $CD95 (left) and $CD9B (right).
;
; On the UKNC we do the recolour through the screen display list instead: a
; palette change on the line before the antlers and another on the line after,
; so showing the energy level costs two display-list entries per frame and
; touches no pixel or attribute data at all.  That makes the 107 attribute
; runs below dead weight at draw time -- they are kept only to hold the
; original layout.
;------------------------------------------------------------------------------

; Branched antlers, left part
LD2C3:	.BYTE	004,220,133,134,135,136,137,140
	.BYTE	141,142,143,144,145,146,147,150
	.BYTE	151,001,152,153,154,155,156,157
	.BYTE	160,161,162,163,164,165,166,167
	.BYTE	170,000,107,107,107,107,107,107
	.BYTE	107,107,107,107,107,107,107,107
	.BYTE	107,200,107,107,107,107,107,107
	.BYTE	107,107,107,107,107,107,107,107
	.BYTE	107,000

; Branched antlers, right part
LD305:	.BYTE	100,220,002,151,150,147,146,145
	.BYTE	144,143,142,141,140,137,136,135
	.BYTE	134,133,001,170,167,166,165,164
	.BYTE	163,162,161,160,157,156,155,154
	.BYTE	153,152,003,000,107,107,107,107
	.BYTE	107,107,107,107,107,107,107,107
	.BYTE	107,107,107,200,107,107,107,107
	.BYTE	107,107,107,107,107,107,107,107
	.BYTE	107,107,107,000

;------------------------------------------------------------------------------
; Menu messages, ZX $ACC6-$AD30.
;
; Printed by $AC83 through $D631, positioned from the table at $D7CE.
;
; Each menu line is stored twice: the text, a 000 terminator, then an equal
; length run of attribute bytes for that same line, and another 000.  The
; original wrote those attribute runs as text, so the disassembly shows them
; as repeated letters -- "FFFFFFF" is seven cells of attribute 106.
;------------------------------------------------------------------------------

LACC6:	.ASCII	/0 START/
	.BYTE	000
LACCE:	.BYTE	106,106,106,106,106,106,106,000	; attributes
LACD6:	.ASCII	/1 KEYBOARD/
	.BYTE	000
LACE1:	.BYTE	105,105,105,105,105,105,105,105	; attributes
	.BYTE	105,105,000
LACEC:	.ASCII	/2 KEMPSTON/
	.BYTE	000
LACF7:	.BYTE	104,104,104,104,104,104,104,104	; attributes
	.BYTE	104,104,000
LAD02:	.ASCII	/3 INTERFACE II/
	.BYTE	000
LAD11:	.BYTE	103,103,103,103,103,103,103,103	; attributes
	.BYTE	103,103,103,103,103,103,000
LAD20:	.ASCII	/4 CURSOR/
	.BYTE	000
LAD29:	.BYTE	102,102,102,102,102,102,102,102	; attributes

